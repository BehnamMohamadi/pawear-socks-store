<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/checkout/checkout.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container"><h1>تکمیل سفارش</h1><div class="checkout-layout"><section><h2>آدرس دریافت</h2><form id="checkoutForm" class="paw-form"><% addresses.forEach((a,i)=>{ %><label class="address-card"><input type="radio" name="addressId" value="<%= a._id %>" <%= i===0?'checked':'' %> required><strong><%= a.title %> — <%= a.recipientName %></strong><span><%= a.province %>، <%= a.city %>، <%= a.addressLine %> — <%= a.postalCode %></span></label><% }) %><% if(addresses.length){ %><button class="btn btn--primary">بررسی نهایی سفارش</button><% } else { %><p>اول آدرس را ثبت کن.</p><% } %></form><div id="orderPreview" hidden><h2>تأیید مبلغ</h2><p id="orderSummary"></p><button class="btn btn--primary" id="payOrder">شروع پرداخت</button><p>موجودی تا پایان مهلت پرداخت برای شما رزرو می‌شود.</p></div></section><section><h2>آدرس جدید</h2><form id="addressForm" class="paw-form"><% for(const [key,label] of Object.entries({title:'عنوان آدرس',recipientName:'نام گیرنده',recipientPhone:'موبایل گیرنده',province:'استان',city:'شهر',addressLine:'آدرس کامل',postalCode:'کد پستی ۱۰ رقمی',buildingNumber:'پلاک',unit:'واحد'})){ %><label><%= label %><input name="<%= key %>" <%= ['buildingNumber','unit'].includes(key)?'':'required' %> maxlength="<%= key==='addressLine'?500:80 %>"></label><% } %><button class="btn btn--outline">ذخیره آدرس</button></form></section></div></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/pages/checkout/checkout.js" defer></script></body></html>
