<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/checkout/checkout.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container"><h1>تکمیل سفارش</h1><div class="checkout-layout"><section><div class="checkout-section-head"><h2>آدرس دریافت</h2><button type="button" class="btn btn--outline" id="showAddressForm">+ آدرس جدید</button></div><form id="checkoutForm" class="paw-form"><div id="addressList"><%addresses.forEach((a,i)=>{%><article class="address-card" data-address-card="<%= a._id %>"><label><input type="radio" name="addressId" value="<%= a._id %>" <%= (a.isDefault||(!addresses.some(x=>x.isDefault)&&i===0))?'checked':'' %> required><strong><%= a.title %> — <%= a.recipientName %></strong><span><%= a.province %>، <%= a.city %>، <%= a.addressLine %> — <%= a.postalCode %></span></label><div class="address-actions"><button type="button" data-edit-address='<%- JSON.stringify(a) %>'>ویرایش</button><button type="button" data-delete-address="<%= a._id %>">حذف</button></div></article><%})%></div><%if(addresses.length){%><button class="btn btn--primary">بررسی نهایی سفارش</button><%}else{%><p>برای ادامه یک آدرس ثبت کن.</p><%}%></form><div id="orderPreview" hidden><h2>تأیید مبلغ</h2><p id="orderSummary"></p><button class="btn btn--primary" id="payOrder">شروع پرداخت</button></div></section><section id="addressEditor" <%= addresses.length?'hidden':'' %>><div class="checkout-section-head"><h2 id="addressEditorTitle">آدرس جدید</h2><button type="button" id="cancelAddress" class="btn btn--outline">انصراف</button></div><form id="addressForm" class="paw-form" data-id=""><%for(const [key,label] of Object.entries({title:'عنوان آدرس',recipientName:'نام گیرنده',recipientPhone:'موبایل گیرنده',province:'استان',city:'شهر',addressLine:'آدرس کامل',postalCode:'کد پستی ۱۰ رقمی',buildingNumber:'پلاک',unit:'واحد'})){%><label><%= label %><input name="<%= key %>" <%= ['buildingNumber','unit'].includes(key)?'':'required' %> maxlength="<%= key==='addressLine'?500:80 %>"></label><%}%><button class="btn btn--primary">ذخیره آدرس</button></form></section></div></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/pages/checkout/checkout.js" defer></script></body></html>
