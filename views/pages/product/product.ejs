<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/product/product.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container"><nav class="breadcrumb"><a href="/">خانه</a><span>/</span><a href="<%= product.type==='box'?'/boxes':'/shop' %>"><%= product.type==='box'?'باکس‌های آماده':'جوراب‌ها' %></a><span>/</span><span><%= product.title %></span></nav><div class="product-detail"><section class="product-gallery" aria-label="تصاویر محصول"><div class="product-gallery__main"><img id="mainProductImage" src="<%= product.image %>" alt="<%= product.title %>" width="800" height="1000" fetchpriority="high"></div><% const gallery=[...new Set([product.image,...(product.images||[])])]; if(gallery.length>1){ %><div class="product-thumbnails"><% gallery.forEach((img,index)=>{ %><button type="button" data-gallery-src="<%= img %>" aria-label="نمایش تصویر <%= index+1 %>" aria-pressed="<%= index===0?'true':'false' %>"><img src="<%= img %>" alt="" loading="lazy" width="100" height="120"></button><% }) %></div><% } %></section><section class="product-info"><span class="eyebrow"><%= product.type==='box'?'THE PAWEAR BOX':'THE EVERYDAY COLLECTION' %></span><h1><%= product.title %></h1><p class="product-meta"><%= product.meta %></p><div class="product-price-row"><strong><%= money(product.price) %></strong><span class="<%= product.stock>0?'in-stock':'out-stock' %>"><%= product.stock>0?'موجود':'ناموجود' %></span></div><p class="product-short-description preserve-lines"><%= (product.description||product.meta).slice(0,220) %></p><div class="product-size"><span>سایز</span><strong>فری‌سایز</strong><a href="/size-guide">راهنمای سایز</a></div><div class="buy-row"><div class="quantity-control"><button type="button" data-quantity-minus aria-label="یک عدد کمتر" <%= product.stock<1?'disabled':'' %>>−</button><label class="sr-only" for="productQuantity">تعداد</label><input id="productQuantity" type="number" value="1" min="1" max="<%= Math.max(1,Math.min(100,product.stock)) %>" <%= product.stock<1?'disabled':'' %>><button type="button" data-quantity-plus aria-label="یک عدد بیشتر" <%= product.stock<1?'disabled':'' %>>+</button></div><button class="btn btn--primary buy-button" data-add-cart="<%= product.id %>" data-type="<%= product.itemType %>" data-quantity="#productQuantity" <%= product.stock<1?'disabled':'' %>><span><%= product.stock>0?'افزودن به سبد خرید':'فعلاً ناموجود' %></span><%- include('../../shared/icons/icon',{name:'bag'}) %></button></div><% if(product.itemType==='Product'){ %><button class="product-save" data-wishlist="<%= product.id %>" aria-pressed="<%= wishlistIds.includes(String(product.id))?'true':'false' %>"><%- include('../../shared/icons/icon',{name:'heart'}) %>ذخیره برای بعد</button><% } %><div class="product-assurance"><span><%- include('../../shared/icons/icon',{name:'check'}) %> قیمت هر <%= product.type==='box'?'باکس':'جفت' %></span><a href="/shipping">ارسال و بازگشت ←</a></div><details class="product-accordion" open><summary>دربارهٔ این <%= product.type==='box'?'باکس':'جوراب' %><span>+</span></summary><p class="preserve-lines"><%= product.description||product.meta %></p></details><% if(product.itemType==='Box'){ %><details class="product-accordion" open><summary>داخل این باکس<span>+</span></summary><ul class="box-components"><% product.components.forEach(c=>{ %><li><span><%= c.name %></span><strong><%= c.quantity.toLocaleString('fa-IR') %> جفت</strong></li><% }) %></ul></details><% } %><% if(product.details?.length){ %><details class="product-accordion"><summary>مشخصات محصول<span>+</span></summary><dl><% product.details.forEach(d=>{ %><div><dt><%= d.title %></dt><dd><%= d.value %></dd></div><% }) %></dl></details><% } %><span class="product-sku">کد محصول: <b dir="ltr"><%= product.sku %></b></span></section></div></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/pages/product/product.js" defer></script></body></html>
