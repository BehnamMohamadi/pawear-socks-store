<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/product/product.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container"><nav class="breadcrumb"><a href="/">خانه</a><span>/</span><a href="<%= product.type==='box'?'/boxes':'/shop' %>"><%= product.type==='box'?'باکس‌ها':'جوراب‌ها' %></a><span>/</span><span><%= product.title %></span></nav><div class="product-detail"><section class="product-gallery"><div class="product-gallery__main"><img id="mainProductImage" src="<%= product.image %>" alt="<%= product.title %>" width="800" height="1000"></div><%const gallery=[...new Set([product.image,...(product.images||[])])];if(gallery.length>1){%><div class="product-thumbnails"><%gallery.forEach((img,index)=>{%><button type="button" data-gallery-src="<%= img %>" aria-pressed="<%= index===0?'true':'false' %>"><img src="<%= img %>" alt="" width="100" height="120"></button><%})%></div><%}%></section><section class="product-info"><span class="eyebrow">PAWEAR / EVERY STEP</span><h1><%= product.title %></h1><p class="product-meta"><%= product.meta %></p><div class="product-price-row"><strong data-selected-price><%= money(product.price) %></strong><span data-stock-label class="<%= product.stock>0?'in-stock':'out-stock' %>"><%= product.stock>0?'موجود':'ناموجود' %></span></div><p class="product-short-description preserve-lines"><%= (product.description||product.meta).slice(0,220) %></p><%if(product.itemType==='Product'&&product.variants?.length){const active=product.variants.filter(v=>v.isActive),def=active.find(v=>String(v._id)===String(product.defaultVariantId))||active.find(v=>v.stock>0)||active[0],sizes=[...new Set(active.map(v=>v.size))],colors=[...new Set(active.map(v=>v.color).filter(Boolean))];%><div class="product-size" data-variant-picker data-variants='<%- JSON.stringify(active.map(v=>({id:String(v._id),size:v.size,color:v.color||"",colorCode:v.colorCode||"",sku:v.sku,price:v.price,stock:v.stock}))) %>' data-default="<%= def?._id||'' %>"><span>سایز</span><div class="variant-options" data-size-options><%sizes.forEach(s=>{%><button type="button" data-size="<%= s %>"><%= s==='free-size'?'فری‌سایز':s %></button><%})%></div><%if(colors.length){%><span>رنگ</span><div class="variant-options" data-color-options><%colors.forEach(c=>{const v=active.find(x=>x.color===c);%><button type="button" data-color="<%= c %>"><i style="--swatch:<%= v.colorCode||'#ddd' %>"></i><%= c %></button><%})%></div><%}%><a href="/size-guide">راهنمای سایز</a></div><%}%><div class="buy-row"><div class="quantity-control" data-buy-quantity><button type="button" data-quantity-minus>−</button><input id="productQuantity" type="number" value="1" min="1" max="<%= Math.max(1,Math.min(100,product.stock)) %>"><button type="button" data-quantity-plus>+</button></div><button class="btn btn--primary buy-button" data-add-cart="<%= product.id %>" data-type="<%= product.itemType %>" data-quantity="#productQuantity" data-variant="<%= product.selectedVariant?.variantId||'' %>" data-size="<%= product.selectedVariant?.size||'' %>" data-color="<%= product.selectedVariant?.color||'' %>" <%= product.stock<1?'disabled':'' %>><span><%= product.stock>0?'افزودن به سبد خرید':'فعلاً ناموجود' %></span></button><div class="quantity-control cart-stepper" data-cart-stepper hidden><button type="button" data-cart-minus>−</button><strong data-cart-qty>1</strong><button type="button" data-cart-plus>+</button></div></div><%if(product.itemType==='Product'){%><button class="product-save" data-wishlist="<%= product.id %>">ذخیره برای بعد</button><%}%><div class="product-assurance"><span>قیمت هر <%= product.type==='box'?'باکس':'جفت' %></span><a href="/shipping">ارسال و بازگشت ←</a></div><details class="product-accordion" open><summary>درباره محصول<span>+</span></summary><p class="preserve-lines"><%= product.description||product.meta %></p></details><%if(product.details?.length){%><details class="product-accordion"><summary>مشخصات<span>+</span></summary><dl><%product.details.forEach(d=>{%><div><dt><%= d.title %></dt><dd><%= d.value %></dd></div><%})%></dl></details><%}%><span class="product-sku">کد محصول: <b dir="ltr" data-selected-sku><%= product.selectedVariant?.sku||product.sku %></b></span></section></div></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/pages/product/product.js" defer></script></body></html>
