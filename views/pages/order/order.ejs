<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container" data-live-region><div class="order-heading"><div><span class="eyebrow">YOUR PAWEAR JOURNEY</span><h1>سفارش <%= order.orderNumber %></h1><span class="live-note" data-live-status>وضعیت سفارش هر ۲۰ ثانیه به‌روز می‌شود</span></div><a class="text-link" href="/account">همه سفارش‌ها ←</a></div><div class="order-layout"><%- include('../../shared/order-tracking',{order}) %></div>
<% if(payment?.status==='pending' && mock){ %><div class="tracking-panel"><strong>پرداخت آزمایشی — وجهی برداشت نمی‌شود</strong><button class="btn btn--primary" data-mock-payment="<%= payment._id %>">شبیه‌سازی پرداخت موفق</button></div><% } %>
<% if(order.status==='pending' && order.paymentStatus==='unpaid'){ %><div class="tracking-panel"><button class="btn btn--primary" data-pay-order="<%= order._id %>">ادامه پرداخت</button><button class="btn btn--outline" data-cancel-order="<%= order._id %>">لغو سفارش پرداخت‌نشده</button></div><% } %>
</div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/shared/live-region.js" defer></script><script src="/javascript/pages/order/order.js" defer></script></body></html>
