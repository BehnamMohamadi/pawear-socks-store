<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container" data-live-region><div class="order-heading"><div><span class="eyebrow"><%= order.status==='pending'&&order.paymentStatus==='unpaid'?'FINAL REVIEW':'YOUR PAWEAR JOURNEY' %></span><h1><%= order.status==='pending'&&order.paymentStatus==='unpaid'?'بررسی نهایی سفارش':'سفارش '+order.orderNumber %></h1><span class="live-note" data-live-status><%= order.status==='pending'&&order.paymentStatus==='unpaid'?'هنوز پرداختی انجام نشده و سفارش نهایی نشده است. همه جزئیات را بررسی کن.':'وضعیت سفارش هر ۲۰ ثانیه به‌روز می‌شود' %></span></div><a class="text-link" href="/account">همه سفارش‌ها ←</a></div><div class="order-layout"><%- include('../../shared/order-tracking',{order}) %></div>
<% if(payment?.status==='pending' && mock){ %><div class="tracking-panel"><strong>پرداخت آزمایشی — وجهی برداشت نمی‌شود</strong><button class="btn btn--primary" data-mock-payment="<%= payment._id %>">شبیه‌سازی پرداخت موفق</button></div><% } %>
<% if(order.status==='pending' && order.paymentStatus==='unpaid'){ %><div class="tracking-panel"><h2>ثبت نهایی سفارش</h2><p>با زدن دکمه پرداخت، موجودی دوباره بررسی و رزرو می‌شود و سفارش وارد مرحله پرداخت می‌شود.</p><button class="btn btn--primary" data-pay-order="<%= order._id %>">پرداخت و ثبت نهایی سفارش</button><button class="btn btn--outline" data-cancel-order="<%= order._id %>">لغو سفارش پرداخت‌نشده</button></div><% } %>
</div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/shared/live-region.js" defer></script><script src="/javascript/pages/order/order.js" defer></script></body></html>
