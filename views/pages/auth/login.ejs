<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/auth/auth.css"></head><body class="auth-body"><main id="main-content" class="auth-layout" data-auth-mode="<%= mode %>"><section class="auth-pane"><div class="auth-top"><a class="wordmark" href="/" aria-label="صفحه اصلی پاور"><img src="/images/pawear-brand/02_logo_light.webp" alt="پاور" width="112" height="57"></a><a class="auth-back" href="/">بازگشت به فروشگاه <span>←</span></a></div><div class="auth-content"><span class="eyebrow"><%= mode==='admin'?'PAWEAR MANAGEMENT':'YOUR EVERYDAY STARTS HERE' %></span><h1><%= mode==='signup'?'به پاور خوش آمدی.':mode==='admin'?'ورود به مدیریت پاور':'خوش برگشتی.' %></h1><p class="auth-intro"><%= mode==='signup'?'حس خوبِ قدم‌های بعدی، از اینجا شروع می‌شود.':mode==='admin'?'برای مدیریت فروشگاه وارد حساب مدیر شو.':'وارد شو و انتخاب‌های خودت را ادامه بده.' %></p>
<div class="auth-tabs" role="tablist" aria-label="روش ورود"><button type="button" id="authTabPassword" role="tab" aria-selected="true" aria-controls="passwordPanel" data-auth-tab="password"><%- include('../../shared/icons/icon',{name:'lock'}) %>رمز ثابت</button><button type="button" id="authTabOtp" role="tab" aria-selected="false" aria-controls="otpPanel" tabindex="-1" data-auth-tab="otp"><%- include('../../shared/icons/icon',{name:'phone'}) %>کد یک‌بارمصرف</button></div>
<section id="passwordPanel" role="tabpanel" aria-labelledby="authTabPassword"><form class="paw-form auth-form" id="authForm" data-mode="<%= mode %>"><% if(mode==='signup'){ %><div class="auth-name-row"><label>نام<input name="firstname" required minlength="2" maxlength="40" autocomplete="given-name" placeholder="نام شما"></label><label>نام خانوادگی<input name="lastname" required minlength="2" maxlength="40" autocomplete="family-name" placeholder="نام خانوادگی"></label></div><% } %><label for="passwordPhone">شماره موبایل</label><div class="auth-input-wrap"><input id="passwordPhone" name="phonenumber" required inputmode="tel" dir="ltr" autocomplete="username" placeholder="0912 345 6789" maxlength="16"><span class="auth-input-icon"><%- include('../../shared/icons/icon',{name:'phone'}) %></span></div><label for="passwordInput"><%= mode==='signup'?'یک رمز ثابت انتخاب کن':'رمز عبور' %></label><div class="auth-input-wrap"><input id="passwordInput" type="password" name="password" minlength="8" maxlength="72" required autocomplete="<%= mode==='signup'?'new-password':'current-password' %>" placeholder="<%= mode==='signup'?'حداقل ۸ کاراکتر':'رمز عبورت را وارد کن' %>"><button class="password-toggle icon-btn" type="button" aria-label="نمایش رمز عبور" aria-pressed="false"><%- include('../../shared/icons/icon',{name:'eye'}) %></button></div><% if(mode!=='signup'){ %><button class="auth-forgot" type="button" data-switch-otp>رمزت را فراموش کردی؟ با کد وارد شو</button><% } else { %><p class="auth-hint">با رمز ثابت، برای ورود به پیامک وابسته نیستی.</p><% } %><button class="btn btn--primary auth-submit" type="submit"><span><%= mode==='signup'?'ساخت حساب من':'ورود به حساب' %></span><%- include('../../shared/icons/icon',{name:'arrow'}) %></button></form></section>
<section id="otpPanel" role="tabpanel" aria-labelledby="authTabOtp" hidden><form class="paw-form auth-form" id="otpForm"><div id="otpPhoneStep"><label for="otpPhone">شماره موبایل</label><div class="auth-input-wrap"><input id="otpPhone" name="phonenumber" inputmode="tel" dir="ltr" required maxlength="16" autocomplete="tel" placeholder="0912 345 6789"><span class="auth-input-icon"><%- include('../../shared/icons/icon',{name:'phone'}) %></span></div><p class="auth-hint">یک کد شش‌رقمی برای ورود دریافت می‌کنی.</p><button class="btn btn--primary auth-submit" id="requestOtp" type="button"><span>دریافت کد ورود</span><%- include('../../shared/icons/icon',{name:'arrow'}) %></button></div><div id="otpCodeStep" hidden><div class="otp-destination"><p>کد ورود برای <b id="otpDestination" dir="ltr"></b></p><button type="button" id="editOtpPhone">ویرایش شماره</button></div><label for="otpCode">کد شش‌رقمی</label><input class="otp-input" id="otpCode" name="code" inputmode="numeric" dir="ltr" pattern="[0-9۰-۹٠-٩]{6}" maxlength="6" autocomplete="one-time-code" placeholder="— — — — — —" required disabled><div id="otpProfile" class="auth-name-row" <%= mode==='signup'?'':'hidden' %>><label>نام<input name="firstname" minlength="2" maxlength="40" autocomplete="given-name" disabled></label><label>نام خانوادگی<input name="lastname" minlength="2" maxlength="40" autocomplete="family-name" disabled></label></div><button class="btn btn--primary auth-submit" type="submit"><span><%= mode==='signup'?'تأیید و ساخت حساب':'تأیید و ورود' %></span><%- include('../../shared/icons/icon',{name:'arrow'}) %></button><div class="otp-resend"><span id="otpTimer"></span><button type="button" id="resendOtp" disabled>ارسال دوبارهٔ کد</button></div></div></form><p class="auth-hint auth-fallback">پیامک در دسترس نیست؟ <button type="button" data-switch-password>با رمز ثابت وارد شو</button></p></section>
<p id="authMessage" class="auth-message" role="status" aria-live="polite"></p><p class="auth-alternate"><%= mode==='signup'?'قبلاً حساب ساخته‌ای؟':'هنوز همراه پاور نیستی؟' %> <a href="<%= mode==='signup'?'/login':'/signup' %>"><%= mode==='signup'?'وارد شو':'ثبت‌نام کن' %></a></p><p class="auth-legal">با ادامه، <a href="/terms">قوانین خرید</a> و <a href="/privacy">حریم خصوصی</a> پاور را می‌پذیری.</p></div><span class="auth-bottom" dir="ltr">SMALL DETAILS. EVERYDAY POWER.</span></section><aside class="auth-visual" aria-label="کالکشن پاور"><img src="/images/pawear-brand/08_lifestyle_sock.webp" alt="هویت تصویری پاور؛ جوراب با لوگوی فارسی پاور" width="507" height="716"><div class="auth-visual__shade"></div><div class="auth-visual__top"><span dir="ltr">PAWEAR / THE EVERYDAY EDIT</span><span>۰۱</span></div><div class="auth-visual__copy"><span class="eyebrow">IT'S ALL IN THE DETAILS.</span><h2>جوراب خوب.<br>قدم‌های قوی‌تر.</h2><p>به سبک خودت قدم بردار.</p></div></aside></main><script src="/javascript/pages/auth/auth.js" defer></script></body></html>
