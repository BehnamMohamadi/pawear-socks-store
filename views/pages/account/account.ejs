<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell account-page"><div class="container"><div class="order-heading"><div><span class="eyebrow">حساب کاربری پاور</span><h1>خوش آمدی، <%= user.firstname %></h1></div><a class="text-link" href="/shop">یک انتخاب تازه ←</a></div><div class="order-layout account-layout"><section data-live-region><div class="order-heading"><h2>سفارش‌های تو</h2><span class="live-note" data-live-status>پیگیری سفارش و تحویل</span></div><% if(!orders.length){ %><div class="tracking-panel"><h3>اولین قدم، هنوز در راه است.</h3><p>بعد از خرید، جزئیات پرداخت و مسیر بسته‌ات همین‌جا دیده می‌شود.</p><a class="btn btn--primary" href="/shop">دیدن جوراب‌ها</a></div><% } %><% orders.forEach(o=>{ %><a class="order-card" href="/orders/<%= o._id %>"><div class="order-card-top"><strong><%= o.orderNumber %></strong><span class="order-status" data-status="<%= o.status %>"><%= statusLabel(o.status) %></span></div><div class="account-order-items"><% o.items.slice(0,4).forEach(i=>{ %><img src="<%= i.productSnapshot.coverImage %>" alt="<%= i.productSnapshot.name %>" width="44" height="52"><% }) %><p><%= o.items.map(i=>i.productSnapshot.name).join('، ') %></p></div><div class="order-card-bottom"><span><%= o.totalPairs %> جفت · <%= money(o.totalAmount) %></span><span>جزئیات و پیگیری ←</span></div><% if(o.customerReceivedAt){ %><span class="live-note">دریافت توسط شما تأیید شده</span><% } %></a><% }) %></section><aside class="account-intro"><span class="eyebrow">PAWEAR CLUB</span><div class="account-avatar"><%= user.firstname.slice(0,1) %></div><h2><%= user.firstname %> <%= user.lastname %></h2><p><span dir="ltr"><%= user.phonenumber %></span></p><a class="btn btn--outline" href="/wishlist">علاقه‌مندی‌ها</a><% if(user.role==='admin'){ %><a class="btn btn--outline" href="/admin">پنل مدیریت</a><% } %><button class="btn btn--outline" data-logout>خروج از حساب</button></aside></div></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/shared/live-region.js" defer></script></body></html>
