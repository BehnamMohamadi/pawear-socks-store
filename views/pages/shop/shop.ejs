<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/shop/shop.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container"><nav class="breadcrumb"><a href="/">خانه</a><span>/</span><span>جوراب‌ها</span></nav><div class="shop-head"><div><span class="eyebrow">THE SOCK COLLECTION</span><h1>جفتِ روزهای تو.</h1><p>از بین جوراب‌های موجود پاور، مدل مناسب خودت را پیدا کن.</p></div><span class="shop-count"><%= total.toLocaleString('fa-IR') %> محصول</span></div><div class="shop-layout"><details class="shop-filter" open><summary>فیلتر و مرتب‌سازی <%- include('../../shared/icons/icon',{name:'chevron'}) %></summary><form action="/shop" method="get" class="paw-form"><label>جستجو<input name="q" value="<%= q %>" maxlength="100" placeholder="نام جوراب یا طرح"></label><label>دسته‌بندی<select name="category"><option value="">همهٔ دسته‌ها</option><% categories.forEach(c=>{ %><option value="<%= c._id %>" <%= filters.category===String(c._id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>مناسب برای<select name="gender"><option value="">همه</option><% for(const [v,l] of Object.entries({unisex:'مشترک',male:'مردانه',female:'زنانه',kids:'بچگانه'})){ %><option value="<%= v %>" <%= filters.gender===v?'selected':'' %>><%= l %></option><% } %></select></label><label>مرتب‌سازی<select name="sort"><% for(const [v,l] of Object.entries({newest:'جدیدترین',cheap:'قیمت: کم به زیاد',expensive:'قیمت: زیاد به کم'})){ %><option value="<%= v %>" <%= filters.sort===v?'selected':'' %>><%= l %></option><% } %></select></label><button class="btn btn--primary">نمایش محصولات</button><a href="/shop" class="filter-reset">پاک کردن فیلترها</a></form><a class="filter-box-link" href="/boxes"><%- include('../../shared/icons/icon',{name:'gift'}) %><span>دنبال هدیه‌ای؟<b>باکس‌ها را ببین ←</b></span></a></details><section class="shop-results"><% if(products.length){ %><div class="product-grid shop-product-grid"><% products.forEach(product=>{ %><%- include('../../shared/product-card/product-card',{product}) %><% }) %></div><% } else { %><div class="shop-empty"><h2>محصولی پیدا نشد.</h2><p><%= q||filters.category||filters.gender?'فیلترها را تغییر بده یا همهٔ جوراب‌ها را ببین.':'هنوز محصول فعالی برای نمایش در فروشگاه ثبت نشده است.' %></p><% if(q||filters.category||filters.gender){ %><a class="btn btn--outline" href="/shop">نمایش همه محصولات</a><% } %></div><% } %><% if(totalPages>1){ %><nav class="pagination" aria-label="صفحه‌بندی"><% if(page>1){ %><a href="<%= pageUrl(page-1) %>">صفحهٔ قبل</a><% } %><span><%= page.toLocaleString('fa-IR') %> / <%= totalPages.toLocaleString('fa-IR') %></span><% if(page<totalPages){ %><a href="<%= pageUrl(page+1) %>">صفحهٔ بعد</a><% } %></nav><% } %></section></div></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/pages/shop/shop.js" defer></script></body></html>
