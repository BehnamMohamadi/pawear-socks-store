<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/cart/cart.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell"><div class="container"><nav class="breadcrumb"><a href="/">خانه</a><span>/</span><span>سبد خرید</span></nav><div class="section-head"><div><span class="eyebrow">YOUR SELECTION</span><h1>انتخاب‌های خوب، اینجاست.</h1></div></div><% if(!cartItems.length){ %><div class="cart-empty"><%- include('../../shared/icons/icon',{name:'bag'}) %><h2>سبدت هنوز خالی است.</h2><p>یک جفت جوراب، می‌تواند شروع خوبی باشد.</p><a class="btn btn--primary" href="/shop">شروع انتخاب ←</a></div><% } else { %><div class="cart-layout"><section class="cart-list" aria-label="اقلام سبد"><% cartItems.forEach(item=>{ %><article class="cart-item" data-cart-item="<%= item.rowId %>" data-unit-price="<%= item.price %>" data-stock="<%= item.stock %>"><img src="<%= item.image %>" alt="<%= item.title %>" width="140" height="175"><div class="cart-item__info"><strong><%= item.title %></strong><span><%= item.meta %></span><% if(!item.available){ %><span class="cart-warning" role="alert">موجودی کافی نیست؛ تعداد را اصلاح یا کالا را حذف کن.</span><% } %><button type="button" data-remove-item>حذف از سبد</button></div><div class="cart-item__qty" aria-label="تعداد <%= item.title %>"><button type="button" data-cart-minus aria-label="کم کردن تعداد" <%= item.qty<=1?'disabled':'' %>>−</button><strong data-cart-quantity><%= item.qty %></strong><button type="button" data-cart-plus aria-label="زیاد کردن تعداد" <%= item.stock<=item.qty?'disabled':'' %>>+</button></div><strong class="cart-item__price" data-line-total><%= money(item.price*item.qty) %></strong></article><% }) %><a class="text-link cart-continue" href="/shop">ادامهٔ دیدن جوراب‌ها ←</a></section><aside class="cart-summary" data-shipping="<%= shippingAmount %>"><span class="eyebrow">ORDER SUMMARY</span><h2>خلاصهٔ سفارش</h2><div><span>جمع محصولات</span><strong data-cart-subtotal><%= money(subtotal) %></strong></div><div><span>هزینهٔ ارسال</span><strong><%= money(shippingAmount) %></strong></div><div class="cart-summary__total"><span>قابل پرداخت</span><strong data-cart-total><%= money(subtotal+shippingAmount) %></strong></div><% if(cartItems.every(i=>i.available)){ %><a class="btn btn--light" href="/checkout" data-checkout-link>ادامه و تکمیل سفارش ←</a><% } %><p>آدرس و مبلغ نهایی را در مرحلهٔ بعد بررسی می‌کنی.</p></aside></div><% } %></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/pages/cart/cart.js" defer></script></body></html>
