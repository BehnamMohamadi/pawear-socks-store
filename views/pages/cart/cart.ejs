<!doctype html><html lang="fa" dir="rtl"><head><%- include('../../shared/seo/head') %><link rel="stylesheet" href="/stylesheet/pages/cart/cart.css"></head><body><%- include('../../shared/header/header') %><main id="main-content" class="page-shell cart-page"><div class="container"><nav class="breadcrumb"><a href="/">خانه</a><span>/</span><span>سبد خرید</span></nav><header class="cart-page__head"><div><h1>سبد خرید</h1><p><%= cartItems.length ? `${cartItems.reduce((sum,item)=>sum+item.qty,0).toLocaleString('fa-IR')} کالا در سبدته` : 'سبدت برای انتخاب‌های بعدی آماده‌ست.' %></p></div><a href="/shop" class="cart-page__continue">ادامه خرید</a></header><% if(!cartItems.length){ %><div class="cart-empty"><div class="cart-empty__icon"><%- include('../../shared/icons/icon',{name:'bag'}) %></div><h2>سبد خریدت خالیه</h2><p>جوراب‌ها و باکس‌های موردعلاقه‌ات رو انتخاب کن و دوباره برگرد اینجا.</p><a class="btn btn--primary" href="/shop">مشاهده جوراب‌ها</a></div><% } else { %><div class="cart-layout"><section class="cart-panel" aria-label="اقلام سبد"><div class="cart-panel__header"><div><strong>سبد خرید شما</strong><span><%= cartItems.length.toLocaleString('fa-IR') %> ردیف کالا</span></div></div><div class="cart-list"><% cartItems.forEach(item=>{ %><article class="cart-item" data-cart-item="<%= item.rowId %>" data-unit-price="<%= item.price %>" data-stock="<%= item.stock %>"><div class="cart-item__main"><a class="cart-item__image" href="<%= item.url || '#' %>" aria-label="مشاهده <%= item.title %>"><img src="<%= item.image %>" alt="<%= item.title %>" width="180" height="220"></a><div class="cart-item__content"><span class="cart-item__type"><%= item.itemType==='Box'?'باکس جوراب':'جوراب' %></span><h2><a href="<%= item.url || '#' %>"><%= item.title %></a></h2><div class="cart-item__meta"><% if(item.meta){ %><span><i></i><%= item.meta %></span><% } %><span><i></i><%= item.stock>0?'موجود در انبار پاور':'ناموجود' %></span><% if(item.itemType==='Box' && item.count){ %><span><i></i><%= item.count.toLocaleString('fa-IR') %> جفت در این باکس</span><% } %></div><% if(!item.available){ %><div class="cart-warning" role="alert">موجودی این کالا برای تعداد انتخابی کافی نیست. تعداد رو کم کن یا کالا رو حذف کن.</div><% } %><div class="cart-item__qty" aria-label="تعداد <%= item.title %>"><button type="button" data-cart-minus aria-label="کم کردن تعداد">−</button><strong data-cart-quantity><%= item.qty %></strong><button type="button" data-cart-plus aria-label="زیاد کردن تعداد" <%= item.stock<=item.qty?'disabled':'' %>>+</button></div></div></div><div class="cart-item__footer"><div class="cart-item__price-wrap"><span>قیمت این ردیف</span><strong class="cart-item__price" data-line-total><%= money(item.price*item.qty) %></strong></div><button type="button" class="cart-item__remove" data-remove-item aria-label="حذف <%= item.title %> از سبد">حذف</button></div></article><% }) %></div><a class="cart-more" href="/shop">اضافه کردن کالای بیشتر ←</a></section><aside class="cart-summary" data-shipping="<%= shippingAmount %>"><h2>خلاصه سفارش</h2><div class="cart-summary__row"><span>قیمت کالاها</span><strong data-cart-subtotal><%= money(subtotal) %></strong></div><div class="cart-summary__row"><span>هزینه ارسال</span><strong><%= money(shippingAmount) %></strong></div><div class="cart-summary__divider"></div><div class="cart-summary__total"><span>قابل پرداخت</span><strong data-cart-total><%= money(subtotal+shippingAmount) %></strong></div><% if(cartItems.every(i=>i.available)){ %><a class="cart-summary__cta" href="/checkout" data-checkout-link>ادامه و تکمیل سفارش</a><% } else { %><p class="cart-summary__warning">برای ادامه، موجودی کالاهای سبد رو اصلاح کن.</p><% } %><p class="cart-summary__note">هزینه نهایی ارسال و آدرس در مرحله بعد دوباره بررسی میشه.</p></aside></div><% } %></div></main><%- include('../../shared/footer/footer') %><script src="/javascript/shared/header/header.js" defer></script><script src="/javascript/pages/cart/cart.js" defer></script></body></html>
