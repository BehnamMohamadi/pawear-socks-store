<article class="product-card <%= product.isPreview?'product-card--preview':'' %>"><div class="product-card__visual"><% if(!product.isPreview){ %><a href="<%= product.url %>" class="product-card__image-link"><% } %><img src="<%= product.image %>" alt="<%= product.title %>" loading="lazy" width="640" height="760"><% if(!product.isPreview){ %></a><% } %><% if(product.badge){ %><span class="product-card__badge"><%= product.badge %></span><% } %><% if(!product.isPreview&&product.itemType==='Product'){ %><button class="product-card__heart" type="button" data-wishlist="<%= product.id %>" aria-pressed="<%= wishlistIds.includes(String(product.id))?'true':'false' %>" aria-label="<%= wishlistIds.includes(String(product.id))?'حذف از علاقه‌مندی‌ها':'افزودن به علاقه‌مندی‌ها' %>"><%- include('../icons/icon',{name:'heart'}) %></button><% } %><% if(!product.isPreview&&product.stock>0){ %><button type="button" class="product-card__quick" data-add-cart="<%= product.id %>" data-type="<%= product.itemType %>"><%- include('../icons/icon',{name:'plus'}) %> افزودن به سبد</button><% } %></div><div class="product-card__body"><div class="product-card__meta"><%= product.meta %></div><h3><% if(!product.isPreview){ %><a href="<%= product.url %>"><%= product.title %></a><% } else { %><%= product.title %><% } %></h3><div class="product-card__bottom"><% if(product.isPreview){ %><span class="product-card__soon">به‌زودی در پاور</span><span class="color-dot color-dot--<%= product.id.split('-').pop() %>" aria-hidden="true"></span><% } else { %><strong class="price"><%= money(product.price) %></strong><span class="stock-note"><%= product.stock>0?'فری‌سایز':'ناموجود' %></span><% } %></div></div></article>
