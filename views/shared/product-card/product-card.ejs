<article class="product-card <%= product.isPreview?'product-card--preview':'' %>"><div class="product-card__visual"><% if(!product.isPreview){ %><a href="<%= product.url %>" class="product-card__image-link"><% } %><img src="<%= product.image %>" alt="<%= product.title %>" loading="lazy" width="640" height="760"><% if(!product.isPreview){ %></a><% } %><% if(product.badge){ %><span class="product-card__badge"><%= product.badge %></span><% } %><% if(!product.isPreview&&product.itemType==='Product'){ %><button class="product-card__heart" type="button" data-wishlist="<%= product.id %>" aria-pressed="<%= wishlistIds.includes(String(product.id))?'true':'false' %>" aria-label="<%= wishlistIds.includes(String(product.id))?'حذف از علاقه‌مندی‌ها':'افزودن به علاقه‌مندی‌ها' %>"><%- include('../icons/icon',{name:'heart'}) %></button><% } %></div><div class="product-card__body"><h3><% if(!product.isPreview){ %><a href="<%= product.url %>"><%= product.title %></a><% } else { %><%= product.title %><% } %></h3><div class="product-card__bottom"><% if(product.isPreview){ %><span class="product-card__soon">پیش‌نمایش برند</span><% } else { %><strong class="price"><%= money(product.price) %></strong><% if(product.stock>0){ %><button type="button" class="product-card__buy" data-add-cart="<%= product.id %>" data-type="<%= product.itemType %>" aria-label="افزودن <%= product.title %> به سبد"><%- include('../icons/icon',{name:'bag'}) %></button><% }else{ %><span class="stock-note">ناموجود</span><% } %><% } %></div></div></article>
