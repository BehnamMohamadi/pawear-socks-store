<% const stage=['confirmed','shipped','delivered'].indexOf(order.status); const a=order.shippingAddressSnapshot||{}; %><section class="tracking-panel"><div class="order-card-top"><h2>مسیر بستهٔ تو</h2><span class="order-status" data-status="<%= order.status %>"><%= statusLabel(order.status) %></span></div><ol class="order-timeline"><li class="done">ثبت سفارش</li><li class="<%= stage>=0?'done':'' %>">آماده‌سازی</li><li class="<%= stage>=1?'done':'' %>">ارسال بسته</li><li class="<%= stage>=2?'done':'' %>">تحویل</li></ol><% if(order.packedAt){ %><p>آماده‌سازی سفارش در <%= date(order.packedAt) %> تکمیل شده.</p><% } %><p><%= order.status==='confirmed'?'پرداخت تأیید شده و سفارش در حال آماده‌سازی است.':order.status==='shipped'?'بسته ارسال شده؛ اطلاعات پیگیری مرسوله پایین همین بخش قرار دارد.':order.status==='delivered'?'تحویل بسته از طرف فروشگاه ثبت شده است.':order.status==='review'?'پرداخت نیازمند بررسی فروشگاه است.':'ارسال پس از تأیید پرداخت و آماده‌سازی انجام می‌شود.' %></p><div class="order-facts"><div><dt>روش ارسال انتخابی</dt><dd><%= order.shippingMethod?.name||order.carrier||'—' %></dd></div><div><dt>هزینه ارسال</dt><dd><%= money(order.shippingAmount) %></dd></div><div><dt>شرکت حمل مرسوله</dt><dd><%= order.carrier||'هنوز ثبت نشده' %></dd></div><div><dt>زمان ارسال</dt><dd><%= order.shippedAt?date(order.shippedAt):'هنوز ارسال نشده' %></dd></div></div><% if(order.trackingCode){ %><div class="tracking-code"><span><%= order.carrier||order.shippingMethod?.name||'حمل‌کننده' %> · کد رهگیری <b dir="ltr"><%= order.trackingCode %></b></span><button class="btn btn--outline" data-copy-tracking="<%= order.trackingCode %>">کپی کد</button></div><% } %><% if(order.customerReceivedAt){ %><p class="live-note">دریافت بسته را در <%= date(order.customerReceivedAt) %> تأیید کردی.</p><% } else if(['shipped','delivered'].includes(order.status)&&order.paymentStatus==='paid'){ %><button class="btn btn--primary" data-confirm-received="<%= order._id %>">بسته را دریافت کردم</button><% } %></section><section class="tracking-panel"><h2>داخل سفارش تو</h2><p><%= order.totalItems %> عدد کالا · <%= order.totalPairs %> جفت جوراب</p><% order.items.forEach(i=>{ %><article class="order-item"><img src="<%= i.productSnapshot.coverImage %>" alt="" width="64" height="76"><div><h3><%= i.productSnapshot.name %></h3><p><%= i.productSnapshot.size?'سایز '+(i.productSnapshot.size==='free-size'?'فری‌سایز':i.productSnapshot.size)+' · ':'' %><%= i.productSnapshot.color?'رنگ '+i.productSnapshot.color+' · ':'' %><%= i.quantity %> عدد · <%= money(i.unitPrice) %></p></div><strong><%= money(i.totalPrice) %></strong></article><% }) %><div class="order-totals"><div><span>جمع کالاها</span><span><%= money(order.subtotal) %></span></div><div><span>ارسال با <%= order.shippingMethod?.name||'روش ثبت‌شده' %></span><span><%= money(order.shippingAmount) %></span></div><div><span>مبلغ نهایی</span><span><%= money(order.totalAmount) %></span></div></div></section><section class="tracking-panel"><h2>مقصد بسته</h2><dl class="order-facts"><div><dt>گیرنده</dt><dd><%= a.recipientName %></dd></div><div><dt>شماره تماس</dt><dd dir="ltr"><%= a.recipientPhone %></dd></div><div class="wide"><dt>آدرس کامل</dt><dd><%= a.province %>، <%= a.city %>، <%= a.addressLine %></dd></div><div><dt>کد پستی</dt><dd dir="ltr"><%= a.postalCode %></dd></div></dl></section>
