<% const stage=['confirmed','shipped','delivered'].indexOf(order.status); const a=order.shippingAddressSnapshot||{}; %>
<section class="tracking-panel">
<div class="order-card-top"><h2>مسیر بستهٔ تو</h2><span class="order-status" data-status="<%= order.status %>"><%= statusLabel(order.status) %></span></div>
<ol class="order-timeline"><li class="done">ثبت سفارش</li><li class="<%= stage>=0?'done':'' %>">آماده‌سازی</li><li class="<%= stage>=1?'done':'' %>">ارسال بسته</li><li class="<%= stage>=2?'done':'' %>">ثبت تحویل</li></ol>
<p><%= order.status==='confirmed'?'پرداخت تأیید شده؛ بسته هنوز ارسال نشده و در مرحلهٔ آماده‌سازی است.':order.status==='shipped'?'بسته ارسال شده است. با کد رهگیری، مسیر مرسوله را از شرکت حمل پیگیری کن.':order.status==='delivered'?'تحویل بسته از طرف فروشگاه ثبت شده است. دریافت خودت را هم می‌توانی پایین صفحه تأیید کنی.':order.status==='review'?'پرداخت نیازمند بررسی فروشگاه است؛ هنوز ارسال انجام نشده.':'ارسال پس از تأیید پرداخت و آماده‌سازی سفارش انجام می‌شود.' %></p>
<% if(order.trackingCode){ %><div class="tracking-code"><span>کد رهگیری <b dir="ltr"><%= order.trackingCode %></b></span><button class="btn btn--outline" data-copy-tracking="<%= order.trackingCode %>">کپی کد</button></div><% } %>
<dl class="order-facts"><div><dt>ثبت سفارش</dt><dd><%= date(order.createdAt) %></dd></div><div><dt>پرداخت</dt><dd><%= statusLabel(order.paymentStatus) %></dd></div><div><dt>زمان ارسال</dt><dd><%= order.shippedAt?date(order.shippedAt):order.trackingCode?'ارسال ثبت شده؛ زمان ثبت نشده':'هنوز ثبت نشده' %></dd></div><div><dt>زمان ثبت تحویل فروشگاه</dt><dd><%= order.deliveredAt?date(order.deliveredAt):order.status==='delivered'?'تحویل ثبت شده؛ زمان ثبت نشده':'هنوز ثبت نشده' %></dd></div></dl>
<% if(order.customerReceivedAt){ %><p class="live-note">دریافت بسته را در <%= date(order.customerReceivedAt) %> تأیید کردی.</p><% } else if(['shipped','delivered'].includes(order.status)&&order.paymentStatus==='paid'){ %><p class="live-note">فقط وقتی بسته به دستت رسیده، دریافت آن را تأیید کن.</p><button class="btn btn--primary" data-confirm-received="<%= order._id %>">بسته را دریافت کردم</button><% } %>
</section>
<section class="tracking-panel"><h2>داخل سفارش تو</h2><p><%= order.totalItems %> عدد کالا · <%= order.totalPairs %> جفت جوراب</p>
<% order.items.forEach(i=>{ %><article class="order-item"><img src="<%= i.productSnapshot.coverImage %>" alt="" width="64" height="76"><div><h3><%= i.productSnapshot.name %></h3><p><%= i.quantity %> عدد · <%= money(i.unitPrice) %> برای هر عدد</p><% if(i.itemType==='Box'){ %><p>داخل هر باکس: <%= i.components.map(c=>c.name+' × '+c.quantity).join('، ') %></p><% } %></div><strong><%= money(i.totalPrice) %></strong></article><% }) %>
<div class="order-totals"><div><span>جمع کالاها</span><span><%= money(order.subtotal) %></span></div><div><span>هزینه ارسال</span><span><%= money(order.shippingAmount) %></span></div><div><span>مبلغ نهایی</span><span><%= money(order.totalAmount) %></span></div></div></section>
<section class="tracking-panel"><h2>مقصد بسته</h2><p>آدرس ثبت‌شده هنگام خرید</p><dl class="order-facts"><div><dt>گیرنده</dt><dd><%= a.recipientName %></dd></div><div><dt>شماره تماس</dt><dd dir="ltr"><%= a.recipientPhone %></dd></div><div class="wide"><dt>آدرس کامل</dt><dd><%= a.province %>، <%= a.city %>، <%= a.addressLine %></dd></div><div><dt>کد پستی</dt><dd dir="ltr"><%= a.postalCode %></dd></div><div><dt>پلاک / واحد</dt><dd><%= a.buildingNumber||'—' %> / <%= a.unit||'—' %></dd></div></dl></section>
