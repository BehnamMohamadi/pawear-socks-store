<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><p><a href="/admin/<%= key %>">← بازگشت</a></p><section class="panel"><form id="resourceForm" class="paw-admin-form" data-resource="<%= key %>" data-api="<%= config.api %>" data-id="<%= record._id||'' %>"><% config.fields.forEach(f=>{const value=f.name==='brandId'?(record.brandId?._id||record.brandId):record[f.name];%><label><span><%= f.label %><%= f.required?' *':'' %></span><%if(f.type==='textarea'){%><textarea name="<%= f.name %>" rows="5"><%= value||'' %></textarea><%}else if(['select','category','subcategory','brand'].includes(f.type)){const options=f.type==='category'?categories.map(c=>[String(c._id),c.name,c]):f.type==='subcategory'?subcategories.map(c=>[String(c._id),c.name,c]):f.type==='brand'?brands.map(b=>[String(b._id),b.name,b]):Object.entries(f.options);%><select name="<%= f.name %>" <%= f.required?'required':'' %>><%if(f.type!=='select'){%><option value="">انتخاب کنید</option><%}%><%options.forEach(([id,label,obj])=>{%><option value="<%= id %>" <%= String(value||'')===id?'selected':'' %> <%= obj?.category?'data-category='+obj.category:'' %>><%= label %><%= obj?.isActive===false?' (غیرفعال)':'' %></option><%})%></select><%}else if(f.type==='checkbox'){%><input name="<%= f.name %>" type="checkbox" <%= value?'checked':'' %>><%}else{%><input name="<%= f.name %>" type="<%= f.type %>" value="<%= value??'' %>" <%= f.required?'required':'' %> <%= f.min!==undefined?'min='+f.min:'' %> <%= f.max!==undefined?'max='+f.max:'' %>><%}%></label><%})%><%if(key==='products'){%><%- include('./variant-editor',{record,sizeOptions,colorOptions}) %><div class="paw-full"><h2>مشخصات تکمیلی</h2><div id="detailRows"><%(record.details||[]).forEach(d=>{%><div class="paw-detail-row"><input data-detail-title value="<%= d.title %>" placeholder="عنوان"><input data-detail-value value="<%= d.value %>" placeholder="مقدار"><button type="button" data-remove-row>حذف</button></div><%})%></div><button type="button" id="addDetail" class="btn btn-secondary">+ مشخصه</button></div><%}%><%if(key==='boxes'){%><div class="paw-full"><h2>جوراب‌های داخل باکس</h2><div class="table-wrap"><table><tbody><%products.flatMap(p=>p.variants?.length?p.variants.map(v=>({...p,price:v.price,stock:v.stock,size:v.size,color:v.color,variantId:v._id,isActive:p.isActive&&v.isActive})):[p]).forEach(p=>{const saved=(record.products||[]).find(item=>String(item.product?._id||item.product)===String(p._id)&&((p.variantId&&String(item.variantId||'')===String(p.variantId))||(!p.variantId&&!item.variantId&&String(item.size||'')===String(p.size||'')&&String(item.color||'')===String(p.color||''))));const savedQty=Number(saved?.quantity||0);%><tr><td><%= p.name %> · <%= p.size||'—' %> <%= p.color||'' %></td><td><%= money(p.price) %></td><td><%= p.stock %></td><td><input data-component="<%= p._id %>" data-variant="<%= p.variantId||'' %>" data-size="<%= p.size||'' %>" data-color="<%= p.color||'' %>" data-price="<%= p.price %>" data-stock="<%= p.stock %>" data-active="<%= p.isActive %>" data-saved-quantity="<%= savedQty %>" type="number" min="0" max="<%= Math.max(Number(p.stock||0),savedQty) %>" value="<%= savedQty %>"></td></tr><%})%></tbody></table></div><p id="boxPreview"></p></div><%}%><div class="paw-full"><div id="validationDetails" class="admin-validation-box" hidden></div><button class="btn btn-primary">ذخیره</button> <span id="formMessage"></span></div></form></section><%if(record._id&&['products','boxes'].includes(key)){%><section class="panel"><h2>تصاویر</h2><form id="imageUpload" class="paw-toolbar" data-key="<%= key %>" data-id="<%= record._id %>"><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required><button class="btn btn-secondary">آپلود</button></form><div class="paw-images"><%(record.images||[]).forEach(img=>{%><label><img src="<%= img %>" width="120" height="120"><span><input type="checkbox" data-keep-image value="<%= img %>" checked>نگه‌داشتن</span><span><input type="radio" name="coverChoice" value="<%= img %>" <%= record.coverImage===img?'checked':'' %>>جلد</span></label><%})%></div><button class="btn btn-secondary" id="saveImages" data-key="<%= key %>" data-id="<%= record._id %>">ذخیره تصاویر</button></section><%}%></main></div><% if(key==='categories'&&record._id&&record.isActive){ %><div class="admin-modal" id="categoryDeactivateModal" hidden aria-hidden="true"><div class="admin-modal__backdrop" data-category-modal-close></div><section class="admin-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="categoryDeactivateTitle"><div class="admin-modal__head"><div><span class="ops-eyebrow">غیرفعال‌سازی وابستگی‌ها</span><h2 id="categoryDeactivateTitle">با غیرفعال شدن این دسته چه چیزهایی غیرفعال شوند؟</h2></div><button type="button" class="admin-modal__close" data-category-modal-close>×</button></div><p>هیچ چیزی خودکار غیرفعال نمی‌شود. موارد موردنظر را خودت انتخاب کن.</p><div class="admin-modal__columns"><section><div class="admin-modal__section-head"><h3>زیردسته‌ها</h3><label><input type="checkbox" data-select-all-subs> انتخاب همه</label></div><div id="categoryModalSubcategories" class="admin-check-list"></div></section><section><div class="admin-modal__section-head"><h3>محصولات</h3><label><input type="checkbox" data-select-all-products> انتخاب همه</label></div><div id="categoryModalProducts" class="admin-check-list"></div></section></div><div class="admin-modal__actions"><button type="button" class="btn btn-secondary" data-category-modal-close>انصراف</button><button type="button" class="btn btn-primary" id="confirmCategoryDeactivate">غیرفعال‌سازی موارد انتخاب‌شده</button></div></section></div><% } %><%- include('../partials/scripts') %><% if(key==='boxes'){ %><script src="/js/admin/box-form.js" defer></script><% } %><script src="/js/admin/pawear.js" defer></script></body></html>
