<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:typeof key==='string'?key:'dashboard',adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><p><a href="/admin/<%= key %>">← بازگشت به فهرست</a></p><section class="panel"><form id="resourceForm" class="paw-admin-form" data-resource="<%= key %>" data-api="<%= config.api %>" data-id="<%= record._id||'' %>"><% config.fields.forEach(f=>{ const value=record[f.name]; %><label><span><%= f.label %><%= f.required?' *':'' %></span><% if(f.type==='textarea'){ %><textarea name="<%= f.name %>" rows="6" maxlength="5000"><%= value||'' %></textarea><% } else if(['select','category','subcategory'].includes(f.type)){ const options=f.type==='category'?categories.map(c=>[String(c._id),c.name,c]):f.type==='subcategory'?subcategories.map(c=>[String(c._id),c.name,c]):Object.entries(f.options); %><select name="<%= f.name %>" <%= f.required?'required':'' %>><% if(f.type!=='select'){ %><option value="">انتخاب کنید</option><% } %><% options.forEach(([id,label,obj])=>{ %><option value="<%= id %>" <%= String(value||'')===id?'selected':'' %> <%= obj?.category?'data-category='+obj.category:'' %>><%= label %><%= obj?.isActive===false?' (غیرفعال)':'' %></option><% }) %></select><% } else if(f.type==='checkbox'){ %><input name="<%= f.name %>" type="checkbox" <%= value?'checked':'' %>><% } else { %><input name="<%= f.name %>" type="<%= f.type %>" value="<%= value??'' %>" <%= f.required?'required':'' %> <%= f.min!==undefined?'min='+f.min:'' %> <%= f.max!==undefined?'max='+f.max:'' %> <%= f.name==='slug'&&record._id?'readonly':'' %>><% } %></label><% }) %>
<% if(key==='users'&&!record._id){ %><label>رمز اولیه<input name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password"></label><% } %>
<% if(key==='users'&&record._id){ %><label>وضعیت حساب<select name="accountState"><% for(const [v,l] of Object.entries({active:'فعال',suspended:'تعلیق',deactivated:'غیرفعال'})){ %><option value="<%= v %>" <%= record.accountStatus.status===v?'selected':'' %>><%= l %></option><% } %></select></label><% } %>
<% if(key==='products'){ %><div class="paw-full"><h2>مشخصات جوراب</h2><p>سایز: فری‌سایز. هر طرح محصول جداست. موجودی واردشده، تعداد قابل فروش بدون رزروهای پرداخت است.</p><div id="detailRows"><% (record.details||[]).forEach(d=>{ %><div class="paw-detail-row"><input data-detail-title value="<%= d.title %>" placeholder="عنوان"><input data-detail-value value="<%= d.value %>" placeholder="مقدار"><button type="button" data-remove-row>حذف</button></div><% }) %></div><button type="button" id="addDetail" class="btn btn-secondary">افزودن مشخصه</button></div><% } %>
<% if(key==='boxes'){ %><div class="paw-full"><h2>جوراب‌های داخل باکس</h2><p>مجموع حداقل ۲ جفت؛ قیمت از جمع جوراب‌ها پس از تخفیف و موجودی از اجزای باکس محاسبه می‌شود.</p><div class="table-wrap"><table><thead><tr><th>جوراب</th><th>قیمت تکی</th><th>موجودی</th><th>تعداد در باکس (صفر = خارج از باکس)</th></tr></thead><tbody><% products.forEach(p=>{const component=record.products?.find(i=>String(i.product)===String(p._id)); %><tr><td><%= p.name %> <%= !p.isActive?'(غیرفعال)':'' %></td><td><%= money(p.price) %></td><td><%= p.stock %></td><td><input data-component="<%= p._id %>" data-price="<%= p.price %>" data-stock="<%= p.stock %>" data-active="<%= p.isActive %>" type="number" min="0" max="100" value="<%= component?.quantity||0 %>"></td></tr><% }) %></tbody></table></div><p id="boxPreview" role="status"></p></div><% } %>
<div class="paw-full"><button class="btn btn-primary">ذخیره</button> <span id="formMessage" role="status"></span></div></form></section>
<% if(record._id && ['products','boxes'].includes(key)){ %><section class="panel"><h2>تصاویر</h2><form id="imageUpload" class="paw-toolbar" data-key="<%= key %>" data-id="<%= record._id %>"><label>گالری (حداکثر ۱۰ تصویر؛ هرکدام ۵ مگابایت)<input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required></label><button class="btn btn-secondary">آپلود تصاویر</button></form><div class="paw-images"><% (record.images||[]).forEach(img=>{ %><label><img src="<%= img %>" alt="<%= record.name %>" width="120" height="120"><span><input type="checkbox" data-keep-image value="<%= img %>" checked>نگه‌داشتن</span><span><input type="radio" name="coverChoice" value="<%= img %>" <%= record.coverImage===img?'checked':'' %>>جلد</span></label><% }) %></div><button class="btn btn-secondary" id="saveImages" data-key="<%= key %>" data-id="<%= record._id %>">ذخیره انتخاب تصاویر</button></section><% } %>
<% if(record._id && ['categories','subcategories'].includes(key)){ %><section class="panel"><h2>تصویر دسته‌بندی</h2><% if(record.icon){ %><img src="<%= record.icon %>" alt="<%= record.name %>" width="100" height="100"><% } %><form id="iconUpload" data-api="<%= config.api %>" data-id="<%= record._id %>" class="paw-toolbar"><input type="file" name="icon" accept="image/jpeg,image/png,image/webp" required><button class="btn btn-secondary">آپلود تصویر</button></form></section><% } %>
<% if(record._id && ['categories','subcategories'].includes(key)){ %><button class="btn btn-danger" data-delete-resource="<%= config.api %>/<%= record._id %>" data-return="/admin/<%= key %>">حذف دسته خالی</button><% } %></main></div><%- include('../partials/scripts') %><script src="/js/admin/pawear.js" defer></script></body></html>
