<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><p><a href="/admin/<%= key %>">← بازگشت</a></p><section class="panel"><form id="resourceForm" class="paw-admin-form" data-resource="<%= key %>" data-api="<%= config.api %>" data-id="<%= record._id||'' %>"><% config.fields.forEach(f=>{const value=f.name==='brandId'?(record.brandId?._id||record.brandId):record[f.name];%><label><span><%= f.label %><%= f.required?' *':'' %></span><%if(f.type==='textarea'){%><textarea name="<%= f.name %>" rows="5"><%= value||'' %></textarea><%}else if(['select','category','subcategory','brand'].includes(f.type)){const options=f.type==='category'?categories.map(c=>[String(c._id),c.name,c]):f.type==='subcategory'?subcategories.map(c=>[String(c._id),c.name,c]):f.type==='brand'?brands.map(b=>[String(b._id),b.name,b]):Object.entries(f.options);%><select name="<%= f.name %>" <%= f.required?'required':'' %>><%if(f.type!=='select'){%><option value="">انتخاب کنید</option><%}%><%options.forEach(([id,label,obj])=>{%><option value="<%= id %>" <%= String(value||'')===id?'selected':'' %> <%= obj?.category?'data-category='+obj.category:'' %>><%= label %><%= obj?.isActive===false?' (غیرفعال)':'' %></option><%})%></select><%}else if(f.type==='checkbox'){%><input name="<%= f.name %>" type="checkbox" <%= value?'checked':'' %>><%}else{%><input name="<%= f.name %>" type="<%= f.type %>" value="<%= value??'' %>" <%= f.required?'required':'' %> <%= f.min!==undefined?'min='+f.min:'' %> <%= f.max!==undefined?'max='+f.max:'' %>><%}%></label><%})%><%if(key==='products'){%><%- include('./variant-editor',{record,sizeOptions,colorOptions}) %><div class="paw-full"><h2>مشخصات تکمیلی</h2><div id="detailRows"><%(record.details||[]).forEach(d=>{%><div class="paw-detail-row"><input data-detail-title value="<%= d.title %>" placeholder="عنوان"><input data-detail-value value="<%= d.value %>" placeholder="مقدار"><button type="button" data-remove-row>حذف</button></div><%})%></div><button type="button" id="addDetail" class="btn btn-secondary">+ مشخصه</button></div><%}%><%if(key==='boxes'){%><div class="paw-full"><h2>جوراب‌های داخل باکس</h2><div class="table-wrap"><table><tbody><%products.flatMap(p=>p.variants?.length?p.variants.map(v=>({...p,price:v.price,stock:v.stock,size:v.size,color:v.color,variantId:v._id,isActive:p.isActive&&v.isActive})):[p]).forEach(p=>{%><tr><td><%= p.name %> · <%= p.size||'—' %> <%= p.color||'' %></td><td><%= money(p.price) %></td><td><%= p.stock %></td><td><input data-component="<%= p._id %>" data-variant="<%= p.variantId||'' %>" data-size="<%= p.size||'' %>" data-color="<%= p.color||'' %>" data-price="<%= p.price %>" data-stock="<%= p.stock %>" data-active="<%= p.isActive %>" type="number" min="0" max="100" value="0"></td></tr><%})%></tbody></table></div><p id="boxPreview"></p></div><%}%><div class="paw-full"><button class="btn btn-primary">ذخیره</button> <span id="formMessage"></span></div></form></section><%if(record._id&&['products','boxes'].includes(key)){%><section class="panel"><h2>تصاویر</h2><form id="imageUpload" class="paw-toolbar" data-key="<%= key %>" data-id="<%= record._id %>"><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required><button class="btn btn-secondary">آپلود</button></form><div class="paw-images"><%(record.images||[]).forEach(img=>{%><label><img src="<%= img %>" width="120" height="120"><span><input type="checkbox" data-keep-image value="<%= img %>" checked>نگه‌داشتن</span><span><input type="radio" name="coverChoice" value="<%= img %>" <%= record.coverImage===img?'checked':'' %>>جلد</span></label><%})%></div><button class="btn btn-secondary" id="saveImages" data-key="<%= key %>" data-id="<%= record._id %>">ذخیره تصاویر</button></section><%}%></main></div><%- include('../partials/scripts') %><script src="/js/admin/pawear.js" defer></script></body></html>
