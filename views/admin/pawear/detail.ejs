<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"><link rel="stylesheet" href="/css/admin/operations.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><p><a href="/admin/<%= key %>">← بازگشت به فهرست</a></p><section class="panel"><% if(key==='orders'){ %><h2>سفارش <%= record.orderNumber %></h2><p>مشتری: <%= [record.user?.firstname,record.user?.lastname].filter(Boolean).join(' ') %> — <span dir="ltr"><%= record.user?.phonenumber %></span></p><p>وضعیت: <strong><%= statusLabel(record.status) %></strong> · پرداخت: <%= statusLabel(record.paymentStatus) %></p><p>جمع کالا: <%= money(record.subtotal) %> · ارسال (<%= record.shippingMethod?.name||'روش ثبت‌شده' %>): <%= money(record.shippingAmount) %> · <strong>مبلغ نهایی: <%= money(record.totalAmount) %></strong></p><section class="dispatch-address"><h3>مقصد ارسال</h3><button type="button" class="btn btn-secondary no-print" data-print-order>چاپ سفارش و نشانی</button><p><%= record.shippingAddressSnapshot?.recipientName %> — <%= record.shippingAddressSnapshot?.recipientPhone %><br><%= record.shippingAddressSnapshot?.province %>، <%= record.shippingAddressSnapshot?.city %>، <%= record.shippingAddressSnapshot?.addressLine %><br>کد پستی: <%= record.shippingAddressSnapshot?.postalCode %></p></section><div class="table-wrap"><table><thead><tr><th>کالا</th><th>تنوع</th><th>تعداد</th><th>قیمت</th></tr></thead><tbody><% record.items.forEach(i=>{ %><tr><td><%= i.productSnapshot.name %><br><small><%= i.productSnapshot.sku||'—' %></small></td><td>سایز: <%= i.productSnapshot.size||'—' %><br>رنگ: <%= i.productSnapshot.color||'—' %></td><td><%= i.quantity %></td><td><%= money(i.totalPrice) %></td></tr><% }) %></tbody></table></div><section class="dispatch-action"><h3>روند آماده‌سازی و ارسال</h3><ol><li>پرداخت سفارش تأیید می‌شود.</li><li>اقلام سفارش آماده و بسته‌بندی می‌شوند.</li><li>شرکت حمل و کد رهگیری ثبت می‌شود.</li><li>سفارش ارسال و سپس تحویل ثبت می‌شود.</li></ol><% if(record.status==='confirmed'&&record.paymentStatus==='paid'&&!record.packedAt){ %><form class="paw-toolbar" data-order-status data-id="<%= record._id %>"><input type="hidden" name="status" value="packed"><label>یادداشت آماده‌سازی<input name="packingNote" maxlength="1000" value="<%= record.packingNote||'' %>"></label><button class="btn btn-primary">سفارش آماده شد</button></form><% } %><% if(record.status==='confirmed'&&record.paymentStatus==='paid'&&record.packedAt){ %><form id="orderStatusForm" class="paw-toolbar" data-id="<%= record._id %>"><input type="hidden" name="status" value="shipped"><label>شرکت حمل<select name="carrier" required><option value="">انتخاب کنید</option><option value="پست">پست</option><option value="تیپاکس">تیپاکس</option><option value="پیک">پیک</option><option value="باربری">باربری</option></select></label><label>کد رهگیری<input name="trackingCode" required maxlength="100"></label><button class="btn btn-primary">ثبت ارسال و کد رهگیری</button></form><% } %><% if(record.status==='shipped'){ %><form id="orderStatusForm" class="paw-toolbar" data-id="<%= record._id %>"><input type="hidden" name="status" value="delivered"><button class="btn btn-primary">ثبت تحویل سفارش</button></form><% } %><p>آماده‌سازی: <%= date(record.packedAt) %> · شرکت حمل: <%= record.carrier||'—' %> · کد رهگیری: <b dir="ltr"><%= record.trackingCode||'—' %></b></p><p>ارسال: <%= date(record.shippedAt) %> · تحویل: <%= date(record.deliveredAt) %> · تأیید مشتری: <%= record.customerReceivedAt?date(record.customerReceivedAt):'هنوز ثبت نشده' %></p></section><h3>پرداخت‌های این سفارش</h3><% payments.forEach(p=>{ %><p><a href="/admin/payments/<%= p._id %>"><%= statusLabel(p.status) %> — <%= money(p.amount) %> — <%= date(p.createdAt) %></a></p><% }) %><% } else if(key==='payments'){ %><h2>جزئیات پرداخت</h2><p>وضعیت: <strong><%= statusLabel(record.status) %></strong></p><p>مبلغ: <%= money(record.amount) %> · درگاه: <%= statusLabel(record.gateway) %></p><p>شماره پیگیری: <span dir="ltr"><%= record.referenceId||'—' %></span></p><p>علت خطا: <%= record.failureReason||'—' %></p><p>وضعیت بررسی: <%= statusLabel(record.reviewStatus) %> · نتیجه: <%= statusLabel(record.resolution) %></p><a class="btn btn-secondary" href="/admin/orders/<%= record.order %>">مشاهده سفارش مرتبط</a><% if(record.requiresReview&&record.reviewStatus!=='resolved'){ %><form id="paymentReviewForm" data-id="<%= record._id %>" class="paw-admin-form"><label>نتیجه بررسی<select name="resolution"><option value="stock_supplied">موجودی تأمین شد؛ سفارش تأیید شود</option><option value="refunded">وجه بازگردانده شد</option></select></label><label>شماره پیگیری بازپرداخت<input name="refundReference" maxlength="200"></label><button class="btn btn-primary">ثبت نتیجه بررسی</button></form><% } %><% } else { %><h2>ویرایش سبد خرید</h2><p>مشتری: <%= [record.user?.firstname,record.user?.lastname].filter(Boolean).join(' ')||'—' %> · <span dir="ltr"><%= record.user?.phonenumber||'—' %></span></p><div class="table-wrap"><table><thead><tr><th>کالا</th><th>تنوع</th><th>تعداد</th><th>عملیات</th></tr></thead><tbody><% record.items.forEach(i=>{ %><tr><td><%= i.itemType %> · <%= i.item %></td><td><%= i.size||'—' %> / <%= i.color||'—' %></td><td><input data-cart-qty data-row="<%= i._id %>" type="number" min="0" value="<%= i.quantity %>"></td><td><button class="btn btn-secondary" data-cart-save data-cart="<%= record._id %>" data-row="<%= i._id %>">ذخیره</button> <button class="btn btn-secondary" data-cart-remove data-cart="<%= record._id %>" data-row="<%= i._id %>">حذف</button></td></tr><% }) %></tbody></table></div><button class="btn btn-secondary" data-cart-clear data-cart="<%= record._id %>">خالی کردن کامل سبد</button><h3>افزودن محصول</h3><select id="cartAddVariant"><option value="">محصول و تنوع را انتخاب کنید</option><% cartProducts.forEach(p=>(p.variants||[]).filter(v=>v.isActive).forEach(v=>{ %><option value="<%= p._id %>" data-variant="<%= v._id %>" data-size="<%= v.size %>" data-color="<%= v.color %>"><%= p.name %> · <%= v.size %> · <%= v.color %> · <%= v.sku %></option><% })) %></select><input id="cartAddQty" type="number" min="1" value="1"><button class="btn btn-primary" data-cart-add data-cart="<%= record._id %>">افزودن به سبد</button><% } %></section></main></div><%- include('../partials/scripts') %><script src="/javascript/shared/live-region.js" defer></script><script src="/js/admin/pawear.js" defer></script></body></html>
