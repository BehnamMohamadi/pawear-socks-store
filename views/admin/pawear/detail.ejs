<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"><link rel="stylesheet" href="/css/admin/operations.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'PAWEAR Operations'}) %><p><a href="/admin/<%= key %>">← Back to list</a></p><section class="panel" data-live-region>
<%if(key==='orders'){%><header class="ops-heading"><div><span class="ops-eyebrow">ORDER / <%= record.orderNumber %></span><h1>Order details</h1><p><%= date(record.createdAt) %></p></div><span class="ops-badge" data-status="<%= record.status %>"><%= record.status %></span></header><div class="ops-metrics"><article><span>Total</span><strong><%= money(record.totalAmount) %></strong></article><article><span>Payment</span><strong><%= record.paymentStatus %></strong></article><article><span>Stock</span><strong><%= record.stockState %></strong></article></div><div class="order-grid"><section class="dispatch-address"><h3>Customer & shipping</h3><p><strong><%= record.user?.firstname %> <%= record.user?.lastname %></strong> · <span dir="ltr"><%= record.user?.phonenumber %></span></p><p><%= record.shippingAddressSnapshot?.recipientName %> · <span dir="ltr"><%= record.shippingAddressSnapshot?.recipientPhone %></span><br><%= record.shippingAddressSnapshot?.province %>، <%= record.shippingAddressSnapshot?.city %>، <%= record.shippingAddressSnapshot?.addressLine %><br>Postal code: <%= record.shippingAddressSnapshot?.postalCode %></p><button type="button" class="btn btn-secondary no-print" data-print-order>Print packing slip</button></section><section class="dispatch-address"><h3>Fulfillment</h3><p>Carrier: <%= record.carrier||'—' %></p><p>Tracking: <span dir="ltr"><%= record.trackingCode||'—' %></span></p><p>Shipped: <%= date(record.shippedAt) %></p><p>Delivered: <%= date(record.deliveredAt) %></p></section></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Variant</th><th>Qty</th><th>Unit / total</th></tr></thead><tbody><%record.items.forEach(i=>{%><tr><td><strong><%= i.productSnapshot.name %></strong><br><small dir="ltr"><%= i.productSnapshot.sku %></small></td><td><%= [i.productSnapshot.size&&i.productSnapshot.size!=='free-size'?i.productSnapshot.size:'Free size',i.productSnapshot.color].filter(Boolean).join(' / ') %></td><td><%= i.quantity %></td><td><%= money(i.unitPrice) %><br><strong><%= money(i.totalPrice) %></strong></td></tr><%})%></tbody></table></div><%if(['confirmed','shipped'].includes(record.status)&&record.paymentStatus==='paid'){%><form id="orderStatusForm" class="paw-toolbar" data-id="<%= record._id %>"><input type="hidden" name="status" value="<%= record.status==='confirmed'?'shipped':'delivered' %>"><%if(record.status==='confirmed'){%><input name="carrier" required maxlength="80" placeholder="Carrier"><input name="trackingCode" required maxlength="100" placeholder="Tracking code"><%}%><button class="btn btn-primary"><%= record.status==='confirmed'?'Mark shipped':'Mark delivered' %></button></form><%}%><h3>Payment attempts</h3><%payments.forEach(p=>{%><p><a href="/admin/payments/<%= p._id %>"><%= p.status %> · <%= money(p.amount) %> · <%= date(p.createdAt) %></a></p><%})%>
<%}else if(key==='payments'){%><header class="ops-heading"><div><span class="ops-eyebrow">PAYMENT / <%= String(record._id).slice(-10) %></span><h1>Payment details</h1><p><%= date(record.createdAt) %></p></div><span class="ops-badge" data-status="<%= record.status %>"><%= record.status %></span></header><div class="ops-metrics"><article><span>Amount</span><strong><%= money(record.amount) %></strong></article><article><span>Gateway</span><strong><%= record.gateway %></strong></article><article><span>Review</span><strong><%= record.reviewStatus||'—' %></strong></article></div><p>Reference: <span dir="ltr"><%= record.referenceId||'—' %></span></p><p>Failure reason: <%= record.failureReason||'—' %></p><p><a href="/admin/orders/<%= record.order %>">Open related order →</a></p><%if(record.requiresReview&&record.reviewStatus!=='resolved'){%><form id="paymentReviewForm" data-id="<%= record._id %>" class="paw-admin-form"><label>Resolution<select name="resolution"><option value="stock_supplied">Stock supplied / confirm order</option><option value="refunded">Refund recorded</option></select></label><label>Refund reference<input name="refundReference" maxlength="200"></label><button class="btn btn-primary">Save resolution</button></form><%}%>
<%}else{%><header class="ops-heading"><div><span class="ops-eyebrow">CART / <%= String(record._id).slice(-10) %></span><h1>Cart editor</h1><p><%= record.user?.firstname %> <%= record.user?.lastname %> · <span dir="ltr"><%= record.user?.phonenumber %></span></p></div><button class="btn btn-danger" data-cart-clear data-cart="<%= record._id %>">Clear cart</button></header><div class="table-wrap"><table><thead><tr><th>Item</th><th>Variant</th><th>Quantity</th><th>Action</th></tr></thead><tbody><%record.items.forEach(i=>{%><tr><td><a href="/admin/<%= i.itemType==='Box'?'boxes':'products' %>/<%= i.item %>/edit"><%= i.item %></a></td><td><%= [i.size,i.color].filter(Boolean).join(' / ')||'—' %></td><td><input type="number" min="0" max="100" value="<%= i.quantity %>" data-cart-qty data-cart="<%= record._id %>" data-row="<%= i._id %>"></td><td><button class="btn btn-secondary" data-cart-save data-cart="<%= record._id %>" data-row="<%= i._id %>">Save</button> <button class="btn btn-danger" data-cart-remove data-cart="<%= record._id %>" data-row="<%= i._id %>">Remove</button></td></tr><%})%></tbody></table></div><section class="dispatch-action"><h3>Add product variant</h3><select id="cartAddVariant"><option value="">Choose product / variant</option><%cartProducts.forEach(p=>p.variants.filter(v=>v.isActive).forEach(v=>{%><option value="<%= p._id %>" data-variant="<%= v._id %>" data-size="<%= v.size %>" data-color="<%= v.color||'' %>"><%= p.name %> · <%= v.size %> <%= v.color||'' %> · <%= v.stock %> in stock</option><%}))%></select><input id="cartAddQty" type="number" min="1" max="100" value="1"><button class="btn btn-primary" data-cart-add data-cart="<%= record._id %>">Add to cart</button></section><h3>Admin audit</h3><div class="table-wrap"><table><thead><tr><th>Time</th><th>Admin</th><th>Action</th></tr></thead><tbody><%audit.forEach(a=>{%><tr><td><%= date(a.createdAt) %></td><td><%= a.admin?.firstname %> <%= a.admin?.lastname %></td><td><%= a.action %></td></tr><%})%></tbody></table></div><%}%></section></main></div><%- include('../partials/scripts') %><script src="/javascript/shared/live-region.js" defer></script><script src="/js/admin/pawear.js" defer></script></body></html>