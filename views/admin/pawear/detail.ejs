<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"><link rel="stylesheet" href="/css/admin/operations.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:typeof key==='string'?key:'dashboard',adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><p><a href="/admin/<%= key %>">← بازگشت به فهرست</a></p><section class="panel" data-live-region><p class="ops-live" data-live-status>به‌روزرسانی خودکار؛ هنگام ویرایش فرم متوقف می‌شود</p><h2><%= record.orderNumber || record._id %></h2><p>مشتری: <%= record.user?.firstname %> <%= record.user?.lastname %> — <%= record.user?.phonenumber %></p><p>ثبت: <%= date(record.createdAt) %> — وضعیت: <%= statusLabel(record.status) %></p>
<% if(key==='orders'){ %><p>پرداخت: <%= statusLabel(record.paymentStatus) %> — موجودی: <%= statusLabel(record.stockState) %></p><p>جمع کالا: <%= money(record.subtotal) %> + ارسال: <%= money(record.shippingAmount) %> = <strong><%= money(record.totalAmount) %></strong></p><div class="dispatch-address"><h3>برگهٔ بسته‌بندی و مقصد ارسال</h3><button type="button" class="btn btn-secondary no-print" data-print-order>چاپ سفارش و نشانی</button><p><%= record.shippingAddressSnapshot?.recipientName %> — <%= record.shippingAddressSnapshot?.recipientPhone %><br><%= record.shippingAddressSnapshot?.province %>، <%= record.shippingAddressSnapshot?.city %>، <%= record.shippingAddressSnapshot?.addressLine %><br>کد پستی <%= record.shippingAddressSnapshot?.postalCode %>، پلاک <%= record.shippingAddressSnapshot?.buildingNumber %>، واحد <%= record.shippingAddressSnapshot?.unit %></p></div><div class="table-wrap"><table><thead><tr><th>کالا</th><th>تعداد</th><th>قیمت</th><th>اجزای ثبت‌شده</th></tr></thead><tbody><% record.items.forEach(i=>{ %><tr><td><%= i.productSnapshot.name %><br><%= i.productSnapshot.sku %><br>سایز: <%= i.productSnapshot.size&&i.productSnapshot.size!=='free-size'?i.productSnapshot.size:i.itemType==='Box'?'طبق اجزای باکس':'فری‌سایز' %></td><td><%= i.quantity %></td><td><%= money(i.totalPrice) %></td><td><% i.components.forEach(c=>{ %><div><%= c.name %> · <%= c.size&&c.size!=='free-size'?c.size:'فری‌سایز' %> × <%= c.quantity %> در هر کالا؛ جمع بسته: <%= c.quantity*i.quantity %> جفت</div><% }) %></td></tr><% }) %></tbody></table></div><% if(record.status==='confirmed'&&record.paymentStatus==='paid'){ %><section class="dispatch-action"><h3>۱. آماده‌سازی بسته</h3><p>اقلام و سایزها را با جدول بالا تطبیق دهید؛ نشانی و شماره گیرنده روی بسته درج شود.</p><form class="paw-toolbar" data-order-status data-id="<%= record._id %>"><input type="hidden" name="status" value="packed"><label>یادداشت بسته‌بندی (فقط مدیر)<input name="packingNote" maxlength="1000" value="<%= record.packingNote||'' %>" placeholder="مثلاً بسته هدیه"></label><button class="btn btn-secondary"><%= record.packedAt?'به‌روزرسانی یادداشت آماده‌سازی':'بسته آماده شد' %></button></form><% if(record.packedAt){ %><p>آماده‌شده در <%= date(record.packedAt) %></p><% } %></section><% } %><% if(['confirmed','shipped'].includes(record.status)&&record.paymentStatus==='paid'){ %><form id="orderStatusForm" class="paw-toolbar" data-id="<%= record._id %>"><input type="hidden" name="status" value="<%= record.status==='confirmed'?'shipped':'delivered' %>"><% if(record.status==='confirmed'){ %><label>شرکت حمل<input name="carrier" list="carrierOptions" required maxlength="80" placeholder="پست، تیپاکس یا پیک"><datalist id="carrierOptions"><option value="پست"><option value="تیپاکس"><option value="پیک"></datalist></label><label>کد رهگیری<input name="trackingCode" required maxlength="100"></label><% } %><button class="btn btn-primary"><%= record.status==='confirmed'?'ثبت ارسال':'ثبت تحویل' %></button></form><% } %><p>حمل‌کننده: <%= record.carrier||'—' %> · کد رهگیری: <%= record.trackingCode||'—' %></p><p>زمان ارسال: <%= date(record.shippedAt) %> — ثبت تحویل: <%= date(record.deliveredAt) %></p><p>تأیید دریافت مشتری: <%= record.customerReceivedAt?date(record.customerReceivedAt):"هنوز تأیید نکرده" %></p><h3>تلاش‌های پرداخت</h3><% payments.forEach(p=>{ %><p><a href="/admin/payments/<%= p._id %>"><%= statusLabel(p.status) %> — <%= money(p.amount) %> — <%= date(p.createdAt) %></a></p><% }) %>
<% } else if(key==='payments'){ %><p>مبلغ: <%= money(record.amount) %> — درگاه: <%= statusLabel(record.gateway) %></p><p>شماره پیگیری: <%= record.referenceId||'—' %></p><p>علت خطا: <%= record.failureReason||'—' %></p><p>بررسی: <%= statusLabel(record.reviewStatus) %> — نتیجه: <%= statusLabel(record.resolution) %></p><a href="/admin/orders/<%= record.order %>">مشاهده سفارش</a><% if(record.requiresReview&&record.reviewStatus!=='resolved'){ %><form id="paymentReviewForm" data-id="<%= record._id %>" class="paw-admin-form"><label>نتیجه بررسی<select name="resolution"><option value="stock_supplied">موجودی تأمین شد؛ تأیید سفارش</option><option value="refunded">وجه خارج از سایت برگشت داده شد</option></select></label><label>شماره پیگیری بازپرداخت<input name="refundReference" maxlength="200"></label><p>گزینه بازپرداخت انتقال پول انجام نمی‌دهد؛ فقط بازگشت وجهی که خودتان انجام داده‌اید ثبت می‌شود.</p><button class="btn btn-primary">ثبت نتیجه نهایی</button></form><% } %><h3>تاریخچه بررسی</h3><% (record.reviewHistory||[]).forEach(h=>{ %><p><%= statusLabel(h.action) %> — <%= h.toResolution ? statusLabel(h.toResolution) : h.reason || '—' %> — <%= date(h.at||h.createdAt) %></p><% }) %>
<% } else { %><p>نسخه سبد: <%= record.revision %></p><% record.items.forEach(i=>{ %><p><%= i.itemType %> — <a href="/admin/<%= i.itemType==='Box'?'boxes':'products' %>/<%= i.item %>/edit"><%= i.item %></a> × <%= i.quantity %></p><% }) %><% } %></section></main></div><%- include('../partials/scripts') %><script src="/javascript/shared/live-region.js" defer></script><script src="/js/admin/pawear.js" defer></script></body></html>
