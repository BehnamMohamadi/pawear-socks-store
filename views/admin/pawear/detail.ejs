<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"><link rel="stylesheet" href="/css/admin/operations.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><p><a href="/admin/<%= key %>">← بازگشت به فهرست</a></p><section class="panel"><% if(key==='orders'){ %><h2>سفارش <span dir="ltr"><%= record.orderNumber %></span></h2><div class="payment-summary"><div><span>مشتری</span><strong><%= [record.user?.firstname,record.user?.lastname].filter(Boolean).join(' ')||'—' %></strong><small dir="ltr"><%= record.user?.phonenumber||'—' %></small></div><div><span>وضعیت سفارش</span><strong><%= record.status==='confirmed'?(record.packedAt?'آماده ارسال':'در حال آماده‌سازی'):statusLabel(record.status) %></strong><small>پرداخت: <%= statusLabel(record.paymentStatus) %></small></div><div><span>مبلغ نهایی</span><strong><%= money(record.totalAmount) %></strong><small>ارسال: <%= money(record.shippingAmount) %></small></div></div><section class="dispatch-address"><h3>مقصد ارسال</h3><button type="button" class="btn btn-secondary no-print" data-print-order>چاپ سفارش و نشانی</button><p><%= record.shippingAddressSnapshot?.recipientName %> — <span dir="ltr"><%= record.shippingAddressSnapshot?.recipientPhone %></span><br><%= record.shippingAddressSnapshot?.province %>، <%= record.shippingAddressSnapshot?.city %>، <%= record.shippingAddressSnapshot?.addressLine %><br>کد پستی: <span dir="ltr"><%= record.shippingAddressSnapshot?.postalCode %></span></p></section><div class="table-wrap"><table><thead><tr><th>کالا</th><th>تنوع</th><th>تعداد</th><th>قیمت</th></tr></thead><tbody><% record.items.forEach(i=>{ %><tr><td><strong><%= i.productSnapshot.name %></strong><br><small><%= i.productSnapshot.sku||'—' %></small></td><td>سایز: <%= i.productSnapshot.size||'—' %><br>رنگ: <%= i.productSnapshot.color||'—' %></td><td><%= i.quantity %></td><td><%= money(i.totalPrice) %></td></tr><% }) %></tbody></table></div><section class="dispatch-action"><h3>آماده‌سازی و ارسال</h3><ol><li>تأیید پرداخت</li><li>آماده‌سازی و بسته‌بندی</li><li>ثبت شرکت حمل و کد رهگیری</li><li>ثبت تحویل به مشتری</li></ol><% if(record.status==='confirmed'&&record.paymentStatus==='paid'&&!record.packedAt){ %><form class="paw-toolbar" data-order-status data-id="<%= record._id %>"><input type="hidden" name="status" value="packed"><label>یادداشت آماده‌سازی<input name="packingNote" maxlength="1000" value="<%= record.packingNote||'' %>" placeholder="اختیاری"></label><button class="btn btn-primary">تأیید آماده‌شدن سفارش</button></form><% } %><% if(record.status==='confirmed'&&record.paymentStatus==='paid'&&record.packedAt){ %><form id="orderStatusForm" class="paw-toolbar" data-id="<%= record._id %>"><input type="hidden" name="status" value="shipped"><label>شرکت حمل<select name="carrier" required><option value="">انتخاب کنید</option><option value="پست">پست</option><option value="تیپاکس">تیپاکس</option><option value="پیک">پیک</option><option value="باربری">باربری</option></select></label><label>کد رهگیری<input name="trackingCode" required maxlength="100" placeholder="کد مرسوله"></label><button class="btn btn-primary">ثبت ارسال و کد رهگیری</button></form><% } %><% if(record.status==='shipped'){ %><form id="orderStatusForm" class="paw-toolbar" data-id="<%= record._id %>"><input type="hidden" name="status" value="delivered"><button class="btn btn-primary">ثبت تحویل سفارش</button></form><% } %><p>آماده‌سازی: <%= date(record.packedAt) %> · شرکت حمل: <%= record.carrier||'—' %> · کد رهگیری: <b dir="ltr"><%= record.trackingCode||'—' %></b></p><p>ارسال: <%= date(record.shippedAt) %> · تحویل: <%= date(record.deliveredAt) %> · تأیید مشتری: <%= record.customerReceivedAt?date(record.customerReceivedAt):'هنوز ثبت نشده' %></p></section><h3>پرداخت‌های سفارش</h3><% payments.forEach(p=>{ %><p><a href="/admin/payments/<%= p._id %>"><%= statusLabel(p.status) %> — <%= money(p.amount) %> — <%= date(p.createdAt) %></a></p><% }) %><% } else if(key==='payments'){ %><h2>جزئیات پرداخت</h2><div class="payment-summary"><div><span>وضعیت</span><strong><%= statusLabel(record.status) %></strong><small><%= record.requiresReview?'نیازمند بررسی':'' %></small></div><div><span>مبلغ</span><strong><%= money(record.amount) %></strong><small>درگاه: <%= statusLabel(record.gateway) %></small></div><div><span>شماره پیگیری</span><strong dir="ltr"><%= record.referenceId||'—' %></strong><small><%= date(record.createdAt) %></small></div></div><p>علت خطا: <%= record.failureReason||'—' %></p><p>وضعیت بررسی: <%= statusLabel(record.reviewStatus) %> · نتیجه: <%= statusLabel(record.resolution) %></p><a class="btn btn-secondary" href="/admin/orders/<%= record.order %>">مشاهده سفارش مرتبط</a><% if(record.requiresReview&&record.reviewStatus!=='resolved'){ %><form id="paymentReviewForm" data-id="<%= record._id %>" class="paw-admin-form"><label>نتیجه بررسی<select name="resolution"><option value="stock_supplied">موجودی تأمین شد؛ سفارش تأیید شود</option><option value="refunded">وجه بازگردانده شد</option></select></label><label>شماره پیگیری بازپرداخت<input name="refundReference" maxlength="200"></label><button class="btn btn-primary">ثبت نتیجه بررسی</button></form><% } %><% } else { %><div class="cart-editor-head"><div><h2>ویرایش سبد خرید</h2><p>تعداد، تنوع و اقلام سبد مشتری را از اینجا مدیریت کن.</p></div><div class="cart-customer"><span class="cart-customer__avatar"><%= (record.user?.firstname||'ک').slice(0,1) %></span><span><strong><%= [record.user?.firstname,record.user?.lastname].filter(Boolean).join(' ')||'—' %></strong><small dir="ltr"><%= record.user?.phonenumber||'—' %></small></span></div></div><div class="table-wrap"><table><thead><tr><th>محصول</th><th>تنوع</th><th>تعداد</th><th>عملیات</th></tr></thead><tbody><% record.items.forEach(i=>{ const item=i.item&&typeof i.item==='object'?i.item:null; %><tr><td><div class="cart-product"><% if(item?.coverImage){ %><img src="<%= item.coverImage %>" alt=""><% } %><span><strong><%= item?.name||'محصول حذف‌شده' %></strong><small><%= item?.sku||String(i.item?._id||i.item||'—') %></small></span></div></td><td><strong><%= i.size||'—' %></strong> · <%= i.color||'—' %></td><td><input class="cart-qty-input" data-cart-qty data-row="<%= i._id %>" type="number" min="0" value="<%= i.quantity %>"></td><td><div class="cart-actions"><button class="btn btn-primary" data-cart-save data-cart="<%= record._id %>" data-row="<%= i._id %>">ذخیره تعداد</button><button class="btn btn-secondary" data-cart-remove data-cart="<%= record._id %>" data-row="<%= i._id %>">حذف</button></div></td></tr><% }) %><% if(!record.items.length){ %><tr><td colspan="4">این سبد خرید خالی است.</td></tr><% } %></tbody></table></div><div class="cart-add-card"><h3>افزودن محصول به سبد</h3><div class="cart-add-row"><label>محصول و تنوع<select id="cartAddVariant"><option value="">انتخاب کنید</option><% cartProducts.forEach(p=>(p.variants||[]).filter(v=>v.isActive).forEach(v=>{ %><option value="<%= p._id %>" data-variant="<%= v._id %>" data-size="<%= v.size %>" data-color="<%= v.color %>"><%= p.name %> · سایز <%= v.size %> · <%= v.color %><%= v.sku?' · '+v.sku:'' %></option><% })) %></select></label><label>تعداد<input id="cartAddQty" type="number" min="1" value="1"></label><button class="btn btn-primary" data-cart-add data-cart="<%= record._id %>">افزودن به سبد</button></div></div><div class="cart-danger"><button class="btn btn-danger" data-cart-clear data-cart="<%= record._id %>">خالی کردن کامل سبد</button></div><% } %></section></main></div><%- include('../partials/scripts') %><script src="/javascript/shared/live-region.js" defer></script><script src="/js/admin/pawear.js" defer></script></body></html>