<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"><link rel="stylesheet" href="/css/admin/operations.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مرکز عملیات فروشگاه'}) %><div data-live-region>
<header class="ops-heading"><div><span class="ops-eyebrow">PAWEAR / OPERATIONS</span><h1><%= key==='orders'?'از ثبت تا رسیدن به دست مشتری':'هر تراکنش، با جزئیات روشن' %></h1><p data-live-status>به‌روزرسانی خودکار هر ۲۰ ثانیه</p></div><button class="btn btn-secondary" data-live-refresh>به‌روزرسانی</button></header>
<% if(key==='orders'){ %><nav class="fulfillment-links" aria-label="مراحل ارسال"><a href="/admin/orders?stage=packing"><strong><%= stageCounts.packing %></strong> منتظر بسته‌بندی</a><a href="/admin/orders?stage=ready"><strong><%= stageCounts.ready %></strong> آماده ارسال</a><a href="/admin/orders?status=shipped"><strong><%= stageCounts.shipped %></strong> ارسال‌شده</a><a href="/admin/orders?status=delivered"><strong><%= stageCounts.delivered %></strong> تحویل‌شده</a></nav><% } %><div class="ops-metrics"><article><span>نتایج این فیلتر</span><strong><%= total.toLocaleString('fa-IR') %></strong></article><article><span>رکورد در این صفحه</span><strong><%= rows.length.toLocaleString('fa-IR') %></strong></article><article><span><%= key==='orders'?'آماده ارسال در این صفحه':'نیازمند بررسی در این صفحه' %></span><strong><%= rows.filter(r=>key==='orders'?r.status==='confirmed'&&r.paymentStatus==='paid':r.requiresReview&&r.reviewStatus!=='resolved').length.toLocaleString('fa-IR') %></strong></article></div>
<form method="get" class="ops-filters" data-live-filter><% if(key==='orders'){ %><% if(filters.stage){ %><input type="hidden" name="stage" value="<%= filters.stage %>"><% } %><input name="q" value="<%= q %>" placeholder="شماره سفارش، گیرنده، موبایل یا شهر" aria-label="جستجوی سفارش"><% } %><select name="status" aria-label="وضعیت"><option value="">همه وضعیت‌ها</option><% (key==='orders'?['pending','payment_pending','review','confirmed','shipped','delivered','cancelled','expired']:['created','pending','processing','paid','failed','cancelled','expired','refunded']).forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }) %></select><% if(key==='payments'){ %><label><input type="checkbox" name="review" value="true" <%= filters.review==='true'?'checked':'' %>> نیازمند بررسی</label><% } %><button class="btn btn-primary">نمایش نتایج</button><a href="/admin/<%= key %>">پاک کردن</a></form>
<div class="ops-list"><% rows.forEach(r=>{ %><article class="ops-record"><div class="ops-record-identity"><span class="ops-avatar"><%= (r.user?.firstname||'م').slice(0,1) %></span><div><a href="/admin/<%= key %>/<%= r._id %>"><strong><%= r.orderNumber || r.referenceId || 'تراکنش '+String(r._id).slice(-8) %></strong></a><p><%= [r.user?.firstname,r.user?.lastname].filter(Boolean).join(' ')||'مشتری' %> · <span dir="ltr"><%= r.user?.phonenumber||'—' %></span></p></div></div><div><strong><%= money(key==='orders'?r.totalAmount:r.amount) %></strong><p><%= key==='orders'?r.totalPairs+' جفت جوراب':statusLabel(r.gateway) %></p></div><div><span class="ops-badge" data-status="<%= r.status %>"><%= r.status==='confirmed'?(r.packedAt?'آماده ارسال':'منتظر بسته‌بندی'):statusLabel(r.status) %></span><p><%= key==='orders'?'پرداخت: '+statusLabel(r.paymentStatus):'بررسی: '+statusLabel(r.reviewStatus) %></p><% if(key==='orders'){ %><p>مقصد: <%= r.shippingAddressSnapshot?.city||'—' %> · <%= r.shippingAddressSnapshot?.recipientName||'—' %></p><% } %><% if(r.customerReceivedAt){ %><small>دریافت مشتری تأیید شده</small><% } %></div><div><p><%= date(r.createdAt) %></p><a class="ops-action" href="/admin/<%= key %>/<%= r._id %>"><%= key==='orders'?'مدیریت سفارش':'بررسی تراکنش' %> ←</a></div></article><% }) %><% if(!rows.length){ %><div class="ops-empty"><span>○</span><h2>هنوز چیزی در این فهرست نیست</h2><p>با ثبت سفارش یا تغییر فیلتر، اطلاعات واقعی اینجا نمایش داده می‌شود.</p></div><% } %></div>
<nav class="paw-toolbar"><% if(page>1){ %><a href="<%= pageUrl(page-1) %>">صفحه قبل</a><% } %><span>صفحه <%= page %></span><% if(page*25<total){ %><a href="<%= pageUrl(page+1) %>">صفحه بعد</a><% } %></nav>
</div></main></div><%- include('../partials/scripts') %><script src="/javascript/shared/live-region.js" defer></script></body></html>
