<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"><link rel="stylesheet" href="/css/admin/operations.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:key==='orders'?'مدیریت، آماده‌سازی و ارسال سفارش‌ها':'مدیریت تراکنش‌های مالی'}) %><div data-live-region><header class="ops-heading"><div><span class="ops-eyebrow">PAWEAR</span><h1><%= key==='orders'?'سفارش‌ها':'پرداخت‌ها' %></h1><p data-live-status>اطلاعات هر ۲۰ ثانیه به‌روز می‌شود</p></div><button class="btn btn-secondary" data-live-refresh>به‌روزرسانی</button></header><% if(key==='orders'){ %><nav class="fulfillment-links"><a href="/admin/orders?stage=packing"><strong><%= stageCounts.packing||0 %></strong> منتظر آماده‌سازی</a><a href="/admin/orders?stage=ready"><strong><%= stageCounts.ready||0 %></strong> آماده ارسال</a><a href="/admin/orders?status=shipped"><strong><%= stageCounts.shipped||0 %></strong> ارسال‌شده</a><a href="/admin/orders?status=delivered"><strong><%= stageCounts.delivered||0 %></strong> تحویل‌شده</a></nav><% } %><form method="get" class="ops-filters" data-live-filter><% if(key==='orders'){ %><input name="q" value="<%= q %>" placeholder="شماره سفارش، نام گیرنده یا موبایل"><% } %><select name="status"><option value="">همه وضعیت‌ها</option><% (key==='orders'?['pending','payment_pending','review','confirmed','shipped','delivered','cancelled','expired']:['created','pending','processing','paid','failed','cancelled','expired','refunded']).forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }) %></select><% if(key==='payments'){ %><label><input type="checkbox" name="review" value="true" <%= filters.review==='true'?'checked':'' %>> فقط نیازمند بررسی</label><% } %><button class="btn btn-primary">اعمال فیلتر</button><a href="/admin/<%= key %>">پاک کردن</a></form><div class="table-wrap"><table class="ops-table"><thead><tr><% if(key==='orders'){ %><th>محصولات</th><th>تاریخ سفارش</th><th>اطلاعات سفارش</th><th>پرداخت</th><th>خریدار</th><th>وضعیت سفارش</th><th>عملیات</th><% }else{ %><th>تراکنش</th><th>تاریخ</th><th>مبلغ</th><th>درگاه</th><th>خریدار</th><th>وضعیت</th><th>عملیات</th><% } %></tr></thead><tbody><% rows.forEach(r=>{ %><tr><% if(key==='orders'){ %><td><strong><%= r.totalItems %> کالا</strong><br><small><%= r.totalPairs %> جفت</small></td><td><%= date(r.createdAt) %></td><td><strong><%= r.orderNumber %></strong><br><small><%= money(r.totalAmount) %></small></td><td><%= statusLabel(r.paymentStatus) %></td><td><%= [r.user?.firstname,r.user?.lastname].filter(Boolean).join(' ')||'—' %><br><small dir="ltr"><%= r.user?.phonenumber||'—' %></small></td><td><span class="ops-badge" data-status="<%= r.status %>"><%= r.status==='confirmed'?(r.packedAt?'آماده ارسال':'در حال آماده‌سازی'):statusLabel(r.status) %></span><br><small><%= r.carrier?'ارسال: '+r.carrier:r.shippingMethod?.name?'روش: '+r.shippingMethod.name:'' %></small></td><td><a class="btn btn-secondary" href="/admin/orders/<%= r._id %>">مدیریت سفارش</a></td><% }else{ %><td><strong><%= r.referenceId||String(r._id).slice(-10) %></strong></td><td><%= date(r.createdAt) %></td><td><%= money(r.amount) %></td><td><%= statusLabel(r.gateway) %></td><td><%= [r.user?.firstname,r.user?.lastname].filter(Boolean).join(' ')||'—' %><br><small dir="ltr"><%= r.user?.phonenumber||'—' %></small></td><td><span class="ops-badge" data-status="<%= r.status %>"><%= statusLabel(r.status) %></span><br><small><%= r.requiresReview&&r.reviewStatus!=='resolved'?'نیازمند بررسی':'' %></small></td><td><a class="btn btn-secondary" href="/admin/payments/<%= r._id %>">جزئیات پرداخت</a></td><% } %></tr><% }) %><% if(!rows.length){ %><tr><td colspan="7">رکوردی با این فیلتر پیدا نشد.</td></tr><% } %></tbody></table></div><nav class="paw-toolbar"><strong><%= total.toLocaleString('fa-IR') %> نتیجه</strong><% if(page>1){ %><a href="<%= pageUrl(page-1) %>">صفحه قبل</a><% } %><span>صفحه <%= page %></span><% if(page*25<total){ %><a href="<%= pageUrl(page+1) %>">صفحه بعد</a><% } %></nav></div></main></div><%- include('../partials/scripts') %><script src="/javascript/shared/live-region.js" defer></script></body></html>
