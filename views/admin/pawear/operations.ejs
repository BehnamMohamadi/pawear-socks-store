<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"><link rel="stylesheet" href="/css/admin/operations.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:key==='orders'?'Orders':'Payments',pageSubtitle:'PAWEAR Operations'}) %><div data-live-region><header class="ops-heading"><div><span class="ops-eyebrow">PAWEAR / OPERATIONS</span><h1><%= key==='orders'?'Order management':'Payment management' %></h1><p data-live-status>Auto refresh every 20 seconds</p></div><button class="btn btn-secondary" data-live-refresh>Refresh</button></header><%if(key==='orders'){%><nav class="fulfillment-links"><a href="/admin/orders?stage=packing"><strong><%= stageCounts.packing||0 %></strong> Awaiting packing</a><a href="/admin/orders?stage=ready"><strong><%= stageCounts.ready||0 %></strong> Ready to ship</a><a href="/admin/orders?status=shipped"><strong><%= stageCounts.shipped||0 %></strong> Shipped</a><a href="/admin/orders?status=delivered"><strong><%= stageCounts.delivered||0 %></strong> Delivered</a></nav><%}%><form method="get" class="ops-filters" data-live-filter><%if(key==='orders'){%><input name="q" value="<%= q %>" placeholder="Order no. / customer / mobile"><%if(filters.stage){%><input type="hidden" name="stage" value="<%= filters.stage %>"><%}%><%}%><select name="status"><option value="">All statuses</option><%(key==='orders'?['pending','payment_pending','review','confirmed','shipped','delivered','cancelled','expired']:['created','pending','processing','paid','failed','cancelled','expired','refunded']).forEach(s=>{%><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><%})%></select><%if(key==='payments'){%><label><input type="checkbox" name="review" value="true" <%= filters.review==='true'?'checked':'' %>> Review required</label><%}%><button class="btn btn-primary">Apply filters</button><a href="/admin/<%= key %>">Clear</a></form><div class="table-wrap ops-table"><table><thead><tr><%if(key==='orders'){%><th>Product details</th><th>Order date</th><th>Order info</th><th>Payment info</th><th>Buyer info</th><th>Order status</th><th></th><%}else{%><th>Transaction</th><th>Date</th><th>Amount</th><th>Gateway</th><th>Payment status</th><th>Review</th><th></th><%}%></tr></thead><tbody><%rows.forEach(r=>{%><tr><%if(key==='orders'){%><td><strong><%= r.totalPairs %> pairs</strong><br><small><%= r.items?.length||0 %> line items</small></td><td><%= date(r.createdAt) %></td><td><strong dir="ltr"><%= r.orderNumber %></strong><br><small><%= money(r.totalAmount) %></small></td><td><span class="ops-badge" data-status="<%= r.paymentStatus %>"><%= r.paymentStatus %></span></td><td><%= [r.user?.firstname,r.user?.lastname].filter(Boolean).join(' ')||'—' %><br><span dir="ltr"><%= r.user?.phonenumber||'—' %></span></td><td><span class="ops-badge" data-status="<%= r.status %>"><%= r.status==='confirmed'?(r.packedAt?'ready_to_ship':'packing'):r.status %></span><br><small><%= r.shippingAddressSnapshot?.city||'—' %></small></td><td><a class="btn btn-secondary" href="/admin/orders/<%= r._id %>">Open</a></td><%}else{%><td><strong dir="ltr"><%= r.referenceId||String(r._id).slice(-10) %></strong></td><td><%= date(r.createdAt) %></td><td><%= money(r.amount) %></td><td><%= r.gateway %></td><td><span class="ops-badge" data-status="<%= r.status %>"><%= r.status %></span></td><td><%= r.requiresReview?(r.reviewStatus||'required'):'—' %></td><td><a class="btn btn-secondary" href="/admin/payments/<%= r._id %>">Open</a></td><%}%></tr><%})%><%if(!rows.length){%><tr><td colspan="7">No records found.</td></tr><%}%></tbody></table></div><nav class="paw-toolbar"><%if(page>1){%><a href="<%= pageUrl(page-1) %>">Previous</a><%}%><span>Page <%= page %> · <%= total %> results</span><%if(page*25<total){%><a href="<%= pageUrl(page+1) %>">Next</a><%}%></nav></div></main></div><%- include('../partials/scripts') %><script src="/javascript/shared/live-region.js" defer></script></body></html>