<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:typeof key==='string'?key:'dashboard',adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><section class="panel"><div class="paw-toolbar"><% if(!config.readonly){ %><a class="btn btn-primary" href="/admin/<%= key %>/new">افزودن</a><% } %><span><%= total.toLocaleString('fa-IR') %> رکورد</span><form method="get" class="paw-toolbar"><% if(!['carts','payments'].includes(key)){ %><input name="q" value="<%= q %>" placeholder="<%= key==='users'?'شماره موبایل':key==='orders'?'شماره سفارش':['products','boxes'].includes(key)?'نام یا کد کالا':'جستجوی نام' %>"><% } %><% if(['products','boxes','categories','subcategories'].includes(key)){ %><select name="active"><option value="">همه وضعیت‌ها</option><option value="true" <%= filters.active==='true'?'selected':'' %>>فعال</option><option value="false" <%= filters.active==='false'?'selected':'' %>>غیرفعال</option></select><% } %><% if(['orders','payments'].includes(key)){ %><select name="status"><option value="">همه وضعیت‌ها</option><% (key==='orders'?['pending','payment_pending','review','confirmed','shipped','delivered','cancelled','expired']:['created','pending','processing','paid','failed','cancelled','expired','refunded']).forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }) %></select><% } %><% if(key==='payments'){ %><label><input type="checkbox" name="review" value="true" <%= filters.review==='true'?'checked':'' %>>نیازمند بررسی</label><% } %><% if(key==='products'){ %><select name="stock" aria-label="فیلتر موجودی"><option value="">همه موجودی‌ها</option><option value="low" <%= filters.stock==='low'?'selected':'' %>>رو به اتمام (۵ جفت یا کمتر)</option><option value="empty" <%= filters.stock==='empty'?'selected':'' %>>ناموجود</option></select><% } %><button class="btn btn-secondary">فیلتر</button><a href="/admin/<%= key %>">پاک کردن</a></form></div><div class="table-wrap"><table><thead><tr><th>عنوان / مشتری</th><th>اطلاعات</th><th>وضعیت</th><th>آخرین تغییر</th><th>عملیات</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.name || r.orderNumber || [r.firstname||r.user?.firstname,r.lastname||r.user?.lastname].filter(Boolean).join(' ') || '—' %><br><small><%= r.sku || r.phonenumber || r.user?.phonenumber || r._id %></small></td><td><% if(key==='products'){ %><%= money(r.price) %><br><%= r.stock %> جفت<% } else if(key==='boxes'){ %><%= r.products.reduce((n,i)=>n+i.quantity,0) %> جفت — <%= r.discount %>٪ تخفیف<% } else if(key==='orders'){ %><%= money(r.totalAmount) %><% } else if(key==='payments'){ %><%= money(r.amount) %> — <%= statusLabel(r.gateway) %><% } else if(key==='carts'){ %><%= r.items.length %> ردیف<% } else if(key==='users'){ %><%= statusLabel(r.role) %><% } else { %>ترتیب: <%= r.sortOrder %><% } %></td><td><%= (r.accountStatus?.status || r.status) ? statusLabel(r.accountStatus?.status || r.status) : (r.isActive===undefined?'—':r.isActive?'فعال':'غیرفعال') %><% if(r.requiresReview){ %><br>بررسی: <%= statusLabel(r.reviewStatus) %><% } %></td><td><%= date(r.updatedAt) %></td><td><a class="btn btn-secondary" href="/admin/<%= key %>/<%= r._id %><%= config.readonly?'':'/edit' %>"><%= config.readonly?'جزئیات':'ویرایش' %></a></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="5">رکوردی پیدا نشد.</td></tr><% } %></tbody></table></div><nav class="paw-toolbar"><% if(page>1){ %><a href="<%= pageUrl(page-1) %>">صفحه قبل</a><% } %><span>صفحه <%= page %></span><% if(page*25<total){ %><a href="<%= pageUrl(page+1) %>">صفحه بعد</a><% } %></nav></section></main></div><%- include('../partials/scripts') %><script src="/js/admin/pawear.js" defer></script></body></html>
