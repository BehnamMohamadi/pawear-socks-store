<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><section class="panel"><div class="paw-toolbar"><%if(!config.readonly){%><a class="btn btn-primary" href="/admin/<%= key %>/new">+ افزودن</a><%}%><strong><%= total.toLocaleString('fa-IR') %> رکورد</strong><form method="get" class="paw-toolbar"><%if(!['carts','payments'].includes(key)){%><input name="q" value="<%= q %>" placeholder="جستجو"><%}%><%if(['products','boxes','brands','categories','subcategories'].includes(key)){%><select name="active"><option value="">همه وضعیت‌ها</option><option value="true" <%= filters.active==='true'?'selected':'' %>>فعال</option><option value="false" <%= filters.active==='false'?'selected':'' %>>غیرفعال</option></select><%}%><%if(key==='products'){%><select name="brand"><option value="">همه برندها</option><%brands.forEach(b=>{%><option value="<%= b._id %>" <%= filters.brand===String(b._id)?'selected':'' %>><%= b.name %></option><%})%></select><select name="stock"><option value="">همه موجودی‌ها</option><option value="low" <%= filters.stock==='low'?'selected':'' %>>رو به اتمام</option><option value="empty" <%= filters.stock==='empty'?'selected':'' %>>ناموجود</option></select><%}%><button class="btn btn-secondary">فیلتر</button><a href="/admin/<%= key %>">پاک کردن</a></form></div><div class="table-wrap"><table><thead><tr><th>عنوان</th><th>اطلاعات</th><th>وضعیت</th><th>آخرین تغییر</th><th>عملیات</th></tr></thead><tbody><%rows.forEach(r=>{%><tr><td><strong><%= r.name||[r.firstname,r.lastname].filter(Boolean).join(' ')||r._id %></strong><br><small><%= r.sku||r.phonenumber||r._id %></small></td><td><%if(key==='products'){%><%= r.brandId?.name||r.brand||'بدون برند' %> · <%= money(r.price) %><br><%= (r.variants?.length||0).toLocaleString('fa-IR') %> تنوع · <%= r.stock %> جفت<%}else if(['brands','categories','subcategories'].includes(key)){%><%= (r.productCount||0).toLocaleString('fa-IR') %> محصول<%}else if(key==='boxes'){%><%= r.products.reduce((n,i)=>n+i.quantity,0) %> جفت<%}else if(key==='carts'){%><%= r.items.length %> ردیف<%}else{%>—<%}%></td><td><%= r.isActive===undefined?(r.accountStatus?.status?statusLabel(r.accountStatus.status):'—'):(r.isActive?'فعال':'غیرفعال') %></td><td><%= date(r.updatedAt) %></td><td><a class="btn btn-secondary" href="/admin/<%= key %>/<%= r._id %><%= config.readonly?'':'/edit' %>"><%= config.readonly?'جزئیات':'ویرایش' %></a></td></tr><%})%><%if(!rows.length){%><tr><td colspan="5">رکوردی پیدا نشد.</td></tr><%}%></tbody></table></div><nav class="paw-toolbar"><%if(page>1){%><a href="<%= pageUrl(page-1) %>">صفحه قبل</a><%}%><span>صفحه <%= page %></span><%if(page*25<total){%><a href="<%= pageUrl(page+1) %>">صفحه بعد</a><%}%></nav></section></main></div><%- include('../partials/scripts') %><script src="/js/admin/pawear.js" defer></script></body></html>
