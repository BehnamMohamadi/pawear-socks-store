<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:key,adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><section class="panel"><div class="paw-toolbar"><%if(!config.readonly){%><a class="btn btn-primary" href="/admin/<%= key %>/new">+ افزودن</a><%}%><strong><%= total.toLocaleString('fa-IR') %> رکورد</strong><form method="get" class="paw-toolbar"><input name="q" value="<%= q %>" placeholder="نام یا جستجوی کلی"><%if(['products','boxes','brands','categories','subcategories','sizes','colors'].includes(key)){%><select name="active"><option value="">همه وضعیت‌ها</option><option value="true" <%= filters.active==='true'?'selected':'' %>>فعال</option><option value="false" <%= filters.active==='false'?'selected':'' %>>غیرفعال</option></select><%}%><%if(key==='products'){%><input name="sku" value="<%= filters.sku||'' %>" placeholder="SKU محصول یا تنوع"><select name="brand"><option value="">همه برندها</option><%brands.forEach(b=>{%><option value="<%= b._id %>" <%= filters.brand===String(b._id)?'selected':'' %>><%= b.name %></option><%})%></select><select name="category"><option value="">همه دسته‌ها</option><%categories.forEach(c=>{%><option value="<%= c._id %>" <%= filters.category===String(c._id)?'selected':'' %>><%= c.name %></option><%})%></select><select name="subcategory"><option value="">همه زیردسته‌ها</option><%subcategories.forEach(s=>{%><option value="<%= s._id %>" <%= filters.subcategory===String(s._id)?'selected':'' %>><%= s.name %></option><%})%></select><select name="size"><option value="">همه سایزها</option><%sizes.forEach(s=>{%><option value="<%= s.label %>" <%= filters.size===s.label?'selected':'' %>><%= s.label %></option><%})%></select><select name="color"><option value="">همه رنگ‌ها</option><%colors.forEach(c=>{%><option value="<%= c.name %>" <%= filters.color===c.name?'selected':'' %>><%= c.name %></option><%})%></select><select name="stock"><option value="">همه موجودی‌ها</option><option value="low" <%= filters.stock==='low'?'selected':'' %>>رو به اتمام</option><option value="empty" <%= filters.stock==='empty'?'selected':'' %>>ناموجود</option></select><%}%><%if(key==='boxes'){%><input name="sku" value="<%= filters.sku||'' %>" placeholder="SKU باکس"><select name="featured"><option value="">همه باکس‌ها</option><option value="true" <%= filters.featured==='true'?'selected':'' %>>منتخب پاور</option><option value="false" <%= filters.featured==='false'?'selected':'' %>>غیرمنتخب</option></select><%}%><button class="btn btn-secondary">فیلتر</button><a href="/admin/<%= key %>">پاک کردن</a></form></div><div class="table-wrap"><table><thead><tr><th>عنوان</th><th>اطلاعات</th><th>وضعیت</th><th>آخرین تغییر</th><th>عملیات</th></tr></thead><tbody><%rows.forEach(r=>{%><tr><td><div class="admin-product-title"><%if(['products','boxes'].includes(key)){%><img src="<%= r.coverImage||'/images/product-placeholder.svg' %>" alt="" width="58" height="72"><%}%><div><strong><%= r.name||r.label||[r.firstname,r.lastname].filter(Boolean).join(' ')||r._id %></strong><br><small><%= r.sku||r.phonenumber||r.code||r._id %></small></div></div></td><td><%if(key==='products'){%><%= r.brandId?.name||r.brand||'—' %> · <%= money(r.price) %><br><%= (r.variants?.length||0).toLocaleString('fa-IR') %> تنوع · <strong><%= r.stock %> جفت موجودی کل</strong><br><small><%= r.category?.name||'—' %> / <%= r.subCategory?.name||'—' %></small><%}else if(key==='boxes'){%><strong><%= (r.pairCount??r.products?.reduce((n,i)=>n+i.quantity,0)??0).toLocaleString('fa-IR') %> جفت</strong><% if(r.computedPrice!=null){ %> · <%= money(r.computedPrice) %><% } %><br><% if(r.computedStock!=null){ %><%= Number(r.computedStock).toLocaleString('fa-IR') %> باکس قابل فروش<% } %><% if(r.discount){ %> · <%= Number(r.discount).toLocaleString('fa-IR') %>٪ تخفیف<% } %><br><small><%= r.isFeatured?'منتخب پاور · ':'' %><%= r.frontMessage||'' %></small><%}else if(['brands','categories','subcategories'].includes(key)){%><%= (r.productCount||0).toLocaleString('fa-IR') %> محصول<%}else if(key==='carts'){%><%= r.items.length %> ردیف<%}else{%>—<%}%></td><td><% if(key==='boxes'){ %><div><%= r.isActive?'فعال':'غیرفعال' %></div><small><%= r.frontStatus==='ready'?'نمایش در فرانت':r.frontStatus==='out'?'ناموجود':r.frontStatus==='invalid'?'قابل فروش نیست':'عدم نمایش در فرانت' %></small><% }else{ %><%= r.isActive===undefined?'—':(r.isActive?'فعال':'غیرفعال') %><% } %></td><td><%= date(r.updatedAt) %></td><td><a class="btn btn-secondary" href="/admin/<%= key %>/<%= r._id %><%= config.readonly?'':'/edit' %>"><%= config.readonly?'جزئیات':'ویرایش' %></a><% if(key==='boxes'&&r.frontStatus==='ready'){ %> <a class="btn btn-secondary" href="/box/<%= r.slug %>" target="_blank" rel="noopener">مشاهده فرانت</a><% } %></td></tr><%})%><%if(!rows.length){%><tr><td colspan="5">رکوردی پیدا نشد.</td></tr><%}%></tbody></table></div><nav class="paw-toolbar"><%if(page>1){%><a href="<%= pageUrl(page-1) %>">صفحه قبل</a><%}%><span>صفحه <%= page %></span><%if(page*25<total){%><a href="<%= pageUrl(page+1) %>">صفحه بعد</a><%}%></nav></section></main></div><%- include('../partials/scripts') %><script src="/js/admin/pawear.js" defer></script></body></html>
