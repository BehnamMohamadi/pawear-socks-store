<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> | PAWEAR</title><link rel="stylesheet" href="/css/admin/admin.css"><link rel="stylesheet" href="/css/admin/pawear.css"></head><body><div class="admin-layout"><%- include('../partials/sidebar',{activePage:typeof key==='string'?key:'dashboard',adminUser}) %><main class="admin-main"><%- include('../partials/topbar',{pageTitle:title,pageSubtitle:'مدیریت فروشگاه پاور'}) %><section class="metric-grid"><% Object.entries(metrics).forEach(([label,value])=>{ %><article class="metric-card"><div class="metric-label"><%= label %></div><strong><%= value.toLocaleString('fa-IR') %></strong></article><% }) %></section><div class="paw-admin-grid"><section class="panel"><h2>موجودی کم</h2><% if(!lowStock.length){ %><p>موردی وجود ندارد.</p><% } %><% lowStock.forEach(p=>{ %><p><a href="/admin/products/<%= p._id %>/edit"><%= p.name %></a> — <%= p.stock %> جفت</p><% }) %></section><section class="panel"><h2>سفارش‌های اخیر</h2><% if(!recent.length){ %><p>هنوز سفارشی ثبت نشده است.</p><% } %><% recent.forEach(o=>{ %><p><a href="/admin/orders/<%= o._id %>"><%= o.orderNumber %></a> — <%= money(o.totalAmount) %> — <%= statusLabel(o.status) %></p><% }) %></section></div><section class="panel"><h2>شروع کار</h2><p>ابتدا دسته‌بندی و زیردسته بسازید، بعد جوراب‌ها را با قیمت و موجودی ثبت کنید. باکس از همان جوراب‌ها ساخته می‌شود و موجودی جدا ندارد.</p><a class="btn btn-primary" href="/admin/products/new">افزودن جوراب</a> <a class="btn btn-secondary" href="/admin/boxes/new">ساخت باکس</a> <a class="btn btn-secondary" href="/" target="_blank" rel="noopener">مشاهده فروشگاه</a></section></main></div><%- include('../partials/scripts') %><script src="/js/admin/pawear.js" defer></script></body></html>
