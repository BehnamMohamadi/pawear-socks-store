NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Use a dedicated NEW database. Do not point this code at the gold-store database.
MONGODB_URI=mongodb://127.0.0.1:27028/pawear?replicaSet=pawearDev
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
TRUST_PROXY=0
# Console prints OTP only outside production. No real SMS provider is configured yet.
SMS_PROVIDER=console
PAYMENT_GATEWAY=mock
# Internal money is integer Toman; gateway conversion is explicit.
PAYMENT_AMOUNT_MULTIPLIER=10
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=http://127.0.0.1:3000/api/payments/zarinpal/callback
# Set the real delivery price before launch. Zero explicitly means free delivery.
SHIPPING_AMOUNT_TOMAN=0
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
ADMIN_PHONENUMBER=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Canonical origin; set your real HTTPS domain before production.
SITE_URL=http://127.0.0.1:3000
STORE_CONTACT=
STORE_SHIPPING_POLICY=
STORE_TERMS=
STORE_PRIVACY_POLICY=
